<view class="ranking-wrap {{dragging ? 'is-dragging' : ''}}">
  <view class="ranking-tip">直接上下拖动，最重要的放在最上方</view>
  <view class="ranking-list">
    <view
      wx:for="{{orderedItems}}"
      wx:key="id"
      class="ranking-item {{draggingId === item.id ? 'is-active' : ''}}"
      style="transform: {{draggingId === item.id ? 'translateY(' + dragOffset + 'px)' : 'none'}};"
      data-index="{{index}}"
      catchtouchstart="onTouchStart"
      catchtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchCancel"
    >
      <view class="rank-number">{{index + 1}}</view>
      <text class="rank-label">{{item.label}}</text>
      <view class="drag-handle"><view class="drag-line"></view><view class="drag-line"></view><view class="drag-line"></view></view>
    </view>
  </view>
</view>
