page {
  background-color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "Segoe UI", Arial, Roboto, "PingFang SC", "miui", "Hiragino Sans GB", "Microsoft Yahei", sans-serif;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  position: relative;
}

.header {
  padding-top: 88rpx;
  padding-bottom: 18rpx;
}

.main {
  flex: 1;
  padding: 28rpx 48rpx 320rpx;
  display: flex;
  flex-direction: column;
}

.title-section {
  text-align: center;
  margin-bottom: 62rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #000000;
  margin-bottom: 18rpx;
  letter-spacing: 0;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  font-weight: 300;
  color: #999999;
  line-height: 1.5;
  letter-spacing: 0;
}

.confirm-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 52rpx 48rpx 54rpx;
  border-radius: 30rpx;
  border: 2rpx solid #ededed;
  background-color: #ffffff;
  transition: all 0.3s ease-out;
  transform: translateY(-18rpx);
}

.confirm-card.ready {
  border-color: #000000;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.06);
}

.confirm-card.success {
  border-color: #000000;
}

.confirm-card.error,
.confirm-card.canceled {
  border-color: #eeeeee;
}

.icon-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background-color: #f8f8f8;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.icon-wrap.success {
  background-color: #000000;
}

.icon-wrap.error,
.icon-wrap.canceled {
  background-color: #f8f8f8;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
}

.avatar-letter {
  font-size: 48rpx;
  font-weight: 700;
  color: #000000;
}

.icon-wrap.success .avatar-letter {
  color: #ffffff;
}

.account-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.account-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #000000;
  margin-bottom: 12rpx;
  max-width: 520rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-role {
  font-size: 24rpx;
  color: #666666;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background-color: #f8f8f8;
}

.status-panel {
  width: 100%;
  padding: 34rpx 32rpx;
  border-radius: 22rpx;
  background-color: #f7f7f8;
  box-sizing: border-box;
  text-align: center;
}

.status-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #000000;
  margin-bottom: 12rpx;
}

.status-desc {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.security-list {
  width: 100%;
  margin-top: 44rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.security-item {
  display: flex;
  align-items: flex-start;
}

.security-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #000000;
  margin-top: 16rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.security-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #666666;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 76rpx 64rpx 64rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(255,255,255,1) 74%, rgba(255,255,255,0));
  z-index: 20;
}

.confirm-btn {
  width: 100% !important;
  height: 112rpx;
  background-color: #e0e0e0;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.1em;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  border: none;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn.active {
  background-color: #000000;
  color: #ffffff;
}

.confirm-btn.active:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.cancel-link-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 32rpx;
  padding: 16rpx;
  transition: opacity 0.2s ease;
}

.cancel-link-wrap:active {
  opacity: 0.6;
}

.cancel-link-text {
  font-size: 24rpx;
  color: #999999;
  letter-spacing: 0;
}

.cancel-link-action {
  font-size: 24rpx;
  color: #ff3b30;
  font-weight: 500;
  margin-left: 8rpx;
  letter-spacing: 0;
  text-decoration: underline;
}
