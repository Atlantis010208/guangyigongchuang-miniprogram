page { background: #f5f5f5; color: #111; }
button { margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; text-align: left; line-height: inherit; }
button::after { border: 0; }
.learning-content-page { min-height: 100vh; padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.content-shell { display: flex; flex-direction: column; gap: 24rpx; }
.content-card,.summary-card,.chapter-card,.record-card,.progress-card,.state-card { background: #fff; border: 1rpx solid #e6e6e6; border-radius: 28rpx; box-sizing: border-box; }
.intro-cover { width: 100%; border-radius: 28rpx; background: #eaeaea; }
.intro-card,.content-card,.summary-card { padding: 32rpx; }
.content-heading { font-size: 38rpx; line-height: 1.35; font-weight: 700; }
.content-subtitle,.chapter-meta,.lesson-meta,.progress-label,.state-text { margin-top: 8rpx; color: #888; font-size: 26rpx; line-height: 1.5; }
.intro-description,.block-copy { margin-top: 24rpx; font-size: 29rpx; line-height: 1.85; white-space: pre-wrap; }
.block-title { margin-bottom: 18rpx; font-size: 32rpx; font-weight: 700; }
.bullet-row { display: flex; align-items: flex-start; gap: 16rpx; padding: 10rpx 0; font-size: 28rpx; line-height: 1.55; }
.bullet-dot { width: 10rpx; height: 10rpx; margin-top: 17rpx; border-radius: 50%; background: #111; flex: none; }
.detail-image { width: 100%; border-radius: 24rpx; background: #eee; }
.chapter-card { overflow: hidden; }
.chapter-header { width: 100%; min-height: 116rpx; padding: 24rpx 30rpx; display: flex; align-items: center; justify-content: space-between; }
.chapter-title { font-size: 30rpx; font-weight: 700; }
.chapter-arrow,.row-arrow { color: #999; font-size: 42rpx; transition: transform .2s; }
.chapter-arrow { transform: rotate(90deg); }
.chapter-arrow--open { transform: rotate(-90deg); }
.lesson-list { border-top: 1rpx solid #ededed; padding-left: 28rpx; }
.lesson-row,.record-row { width: 100%; min-height: 112rpx; padding: 22rpx 28rpx 22rpx 0; display: flex; align-items: center; gap: 20rpx; border-bottom: 1rpx solid #ededed; }
.lesson-row:last-child,.record-row:last-child { border-bottom: 0; }
.lesson-index,.record-status { width: 58rpx; height: 58rpx; border: 2rpx solid #111; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 23rpx; flex: none; }
.record-status { width: 72rpx; height: 72rpx; font-size: 22rpx; }
.record-status--done { color: #fff; background: #111; }
.lesson-copy { min-width: 0; flex: 1; }
.lesson-title { font-size: 29rpx; font-weight: 600; line-height: 1.45; }
.progress-card { min-height: 190rpx; padding: 34rpx; display: flex; align-items: center; justify-content: space-around; text-align: center; }
.progress-value { font-size: 44rpx; font-weight: 700; }
.progress-divider { width: 1rpx; height: 78rpx; background: #ddd; }
.record-card { padding-left: 28rpx; overflow: hidden; }
.state-card { min-height: 480rpx; margin-top: 20rpx; padding: 72rpx 36rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.state-spinner { width: 54rpx; height: 54rpx; margin-bottom: 24rpx; border: 5rpx solid #ddd; border-top-color: #111; border-radius: 50%; animation: spin .8s linear infinite; }
.state-symbol { width: 80rpx; height: 80rpx; margin-bottom: 24rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: #111; font-size: 42rpx; font-weight: 700; }
.state-symbol--empty { color: #777; background: #eee; }
.state-title { font-size: 34rpx; font-weight: 700; }
.retry-button { margin-top: 34rpx; padding: 22rpx 56rpx; border-radius: 999rpx; color: #fff; background: #111; font-size: 28rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
