<view class="learning-content-page">
  <view wx:if="{{status === 'loading'}}" class="state-card">
    <view class="state-spinner"></view>
    <text class="state-text">正在加载{{title}}</text>
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card">
    <view class="state-symbol">!</view>
    <text class="state-title">加载失败</text>
    <text class="state-text">{{errorMessage}}</text>
    <button class="retry-button" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{status === 'empty'}}" class="state-card">
    <view class="state-symbol state-symbol--empty">—</view>
    <text class="state-title">暂无{{title}}</text>
    <text class="state-text">后台更新内容后将在这里显示</text>
  </view>

  <view wx:else>
    <view wx:if="{{section === 'intro'}}" class="content-shell">
      <image wx:if="{{introduction.coverUrl}}" class="intro-cover" src="{{introduction.coverUrl}}" mode="widthFix" />
      <view class="content-card intro-card">
        <view class="content-heading">{{introduction.title}}</view>
        <view wx:if="{{introduction.subtitle}}" class="content-subtitle">{{introduction.subtitle}}</view>
        <view wx:if="{{introduction.description}}" class="intro-description">{{introduction.description}}</view>
      </view>
      <view wx:if="{{introduction.highlights.length}}" class="content-card">
        <view class="block-title">课程亮点</view>
        <view wx:for="{{introduction.highlights}}" wx:key="*this" class="bullet-row"><text class="bullet-dot"></text><text>{{item}}</text></view>
      </view>
      <view wx:if="{{introduction.targetAudience}}" class="content-card">
        <view class="block-title">适合人群</view>
        <view class="block-copy">{{introduction.targetAudience}}</view>
      </view>
      <image wx:for="{{introduction.detailImages}}" wx:key="*this" class="detail-image" src="{{item}}" mode="widthFix" />
    </view>

    <view wx:elif="{{section === 'catalog'}}" class="content-shell">
      <view class="summary-card">
        <view class="content-heading">{{catalog.title}}</view>
        <view class="content-subtitle">共 {{catalog.chapters.length}} 章 · {{catalog.totalLessons}} 个课时</view>
      </view>
      <view wx:for="{{catalog.chapters}}" wx:key="index" class="chapter-card">
        <button class="chapter-header" data-index="{{index}}" bindtap="toggleChapter">
          <view><view class="chapter-title">{{item.index}}. {{item.title}}</view><view class="chapter-meta">{{item.lessonCount}} 个课时</view></view>
          <text class="chapter-arrow {{expandedChapters[index] ? 'chapter-arrow--open' : ''}}">›</text>
        </button>
        <view wx:if="{{expandedChapters[index]}}" class="lesson-list">
          <button wx:for="{{item.lessons}}" wx:for-item="lesson" wx:key="id" class="lesson-row" data-lesson-id="{{lesson.id}}" data-lesson-type="{{lesson.type}}" bindtap="openLesson">
            <view class="lesson-index">{{lesson.index}}</view>
            <view class="lesson-copy"><view class="lesson-title">{{lesson.title}}</view><view class="lesson-meta">{{lesson.type === 'video' ? (lesson.duration || '视频') : (lesson.type === 'quiz' ? '作业' : (lesson.format || '资料'))}}</view></view>
            <text class="row-arrow">›</text>
          </button>
        </view>
      </view>
    </view>

    <view wx:else class="content-shell">
      <view class="progress-card">
        <view><view class="progress-value">{{history.progress}}%</view><view class="progress-label">课程进度</view></view>
        <view class="progress-divider"></view>
        <view><view class="progress-value">{{history.completedCount}}/{{history.totalLessons}}</view><view class="progress-label">已完成课时</view></view>
      </view>
      <view class="record-card">
        <button wx:for="{{history.records}}" wx:key="lessonId" class="record-row" data-lesson-id="{{item.lessonId}}" data-lesson-type="video" bindtap="openLesson">
          <view class="record-status {{item.isCompleted ? 'record-status--done' : ''}}">{{item.isCompleted ? '✓' : item.progress + '%'}}</view>
          <view class="lesson-copy"><view class="lesson-title">{{item.lessonTitle}}</view><view class="lesson-meta">{{item.chapterTitle}}</view></view>
          <text class="row-arrow" data-lesson-id="{{item.lessonId}}" data-lesson-type="video" catchtap="openLesson">›</text>
        </button>
      </view>
    </view>
  </view>
</view>
