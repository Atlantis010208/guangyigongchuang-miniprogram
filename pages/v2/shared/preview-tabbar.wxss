.preview-tabbar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #ebebeb;
}

.preview-tabbar__inner {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  height: 108rpx;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
  height: 108rpx;
  padding-top: 8rpx;
  color: #858585;
}

.tab-icon {
  display: block;
  width: 56rpx;
  height: 52rpx;
}

.tab-label {
  margin-top: 0;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.tab-item--active {
  color: #090909;
}

.tab-item--active .tab-label {
  font-weight: 600;
}

@media (min-width: 430px) {
  .preview-tabbar {
    right: 50%;
    left: auto;
    width: 430px;
    transform: translateX(50%);
  }
}
