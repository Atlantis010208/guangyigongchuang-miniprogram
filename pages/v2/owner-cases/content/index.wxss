.owner-cases {
  min-height: 100vh;
  overflow-x: hidden;
  color: #090909;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  background: #faf9f8;
}

.case-panel-button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  color: inherit;
  font: inherit;
  line-height: inherit;
  text-align: left;
  background: transparent;
  border: 0;
  border-radius: 0;
}

.case-panel-button::after {
  border: 0;
}

.status-space,
.custom-nav {
  position: relative;
  z-index: 4;
}

.custom-nav {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 36rpx;
}

.avatar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-left: -16rpx;
}

.avatar {
  display: block;
  width: 56rpx;
  height: 56rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  border-radius: 50%;
}

.case-content {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  background: #faf9f8;
}

.intro {
  padding: 0 44rpx;
}

.page-title {
  color: #090909;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
  letter-spacing: 0.5rpx;
}

.page-subtitle {
  color: #656565;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 34rpx;
  white-space: nowrap;
}

.search-box {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  height: 54rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid #dedede;
  border-radius: 28rpx;
}

.search-icon {
  position: absolute;
  top: 15rpx;
  left: 22rpx;
  box-sizing: border-box;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #4d4d4d;
  border-radius: 50%;
}

.search-icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 2rpx;
  background: #4d4d4d;
  content: "";
  transform: rotate(45deg);
  transform-origin: left center;
}

.search-input {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding: 0 22rpx 0 60rpx;
  color: #333333;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 54rpx;
}

.search-placeholder {
  color: #a3a3a3;
}

.category-row {
  display: flex;
  align-items: center;
  width: 400rpx;
  height: 48rpx;
}

.category {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 90rpx;
  height: 40rpx;
  margin-right: 10rpx;
  color: #686868;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
  border-radius: 999rpx;
}

.category:first-child {
  flex-basis: 86rpx;
  margin-right: 24rpx;
}

.category:last-child {
  margin-right: 0;
}

.category::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 88rpx;
  content: "";
  transform: translate(-50%, -50%);
}

.category--active {
  color: #ffffff;
  background: #050505;
}

.category--pressed {
  opacity: 0.65;
}

.cases-section {
  padding: 0 42rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 40rpx;
}

.section-title {
  color: #0b0b0b;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  letter-spacing: 0.2rpx;
}

.filter-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 86rpx;
  height: 40rpx;
  color: #6f6f6f;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.filter-button::after {
  position: absolute;
  top: 50%;
  right: 0;
  width: 100rpx;
  height: 88rpx;
  content: "";
  transform: translateY(-50%);
}

.filter-image {
  display: block;
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.case-grid {
  display: grid;
  grid-template-columns: 316rpx minmax(0, 1fr);
  column-gap: 34rpx;
}

.case-card {
  position: relative;
  min-width: 0;
}

.case-card--pressed .case-image {
  opacity: 0.82;
}

.case-image {
  display: block;
  width: 100%;
  overflow: hidden;
  border-radius: 8rpx;
}

.case-title-row {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 0;
  height: 34rpx;
  margin-top: 10rpx;
}

.case-title {
  min-width: 0;
  padding-right: 34rpx;
  overflow: hidden;
  color: #111111;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.case-description {
  overflow: hidden;
  color: #767676;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bookmark-button {
  position: absolute;
  z-index: 2;
  top: -25rpx;
  right: -18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
}

.bookmark-image {
  display: block;
  width: 24rpx;
  height: 30rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 280rpx;
  color: #8c8c8c;
  font-size: 22rpx;
}

.tap-soft {
  opacity: 0.58;
}

@media (min-width: 430px) {
  .owner-cases {
    max-width: 430px;
    margin: 0 auto;
    box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.03);
  }
}

