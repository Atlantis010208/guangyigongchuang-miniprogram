page {
  min-height: 100%;
  color: #111111;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  background: #faf9f7;
}

.plain-button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  color: inherit;
  font: inherit;
  line-height: inherit;
  text-align: left;
  background: transparent;
  border: 0;
  border-radius: 0;
}

.plain-button::after {
  border: 0;
}

.case-detail {
  min-height: 100vh;
  overflow-x: hidden;
  background: #faf9f7;
}

.status-space,
.custom-nav {
  position: relative;
  z-index: 5;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0;
}

.back-button {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  min-height: 44px;
}

.back-chevron {
  box-sizing: border-box;
  width: 22rpx;
  height: 22rpx;
  margin-left: 0;
  border-bottom: 3rpx solid #111111;
  border-left: 3rpx solid #111111;
  transform: rotate(45deg);
}

.nav-title {
  position: absolute;
  left: 50%;
  max-width: 260rpx;
  overflow: hidden;
  color: #151515;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
  letter-spacing: 2rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  transform: translateX(-50%);
}

.detail-content {
  box-sizing: border-box;
  padding-bottom: calc(58px + env(safe-area-inset-bottom));
}

.hero-wrap {
  position: relative;
  margin: 0 36rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.hero-swiper {
  width: 100%;
  height: 418rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.hero-image {
  display: block;
  width: 100%;
  height: 100%;
}

.slide-counter {
  position: absolute;
  z-index: 3;
  right: 9rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 42rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 28rpx;
  letter-spacing: 1rpx;
  background: rgba(10, 10, 10, 0.76);
  border-radius: 999rpx;
}

.intro-block {
  margin: 18rpx 40rpx 0;
}

.case-category,
.case-meta {
  color: #858585;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 34rpx;
  letter-spacing: 1rpx;
}

.case-title {
  margin-top: 8rpx;
  color: #111111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 46rpx;
  letter-spacing: 2rpx;
}

.case-meta {
  margin-top: 2rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 26rpx 36rpx 0;
  padding: 22rpx 0 20rpx;
  border-top: 1rpx solid #e7e5e2;
  border-bottom: 1rpx solid #e7e5e2;
}

.summary-item {
  position: relative;
  min-width: 0;
  padding-left: 4rpx;
}

.summary-item + .summary-item {
  padding-left: 68rpx;
}

.summary-item + .summary-item::before {
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  left: 0;
  width: 1rpx;
  background: #e3e1de;
  content: "";
}

.summary-label {
  overflow: hidden;
  color: #888888;
  font-size: 18rpx;
  font-weight: 400;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-value {
  margin-top: 8rpx;
  overflow: hidden;
  color: #252525;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-section {
  margin-right: 40rpx;
  margin-left: 40rpx;
}

.concept-section {
  margin-top: 30rpx;
}

.section-title,
.closing-title {
  color: #171717;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 36rpx;
  letter-spacing: 1rpx;
}

.concept-copy {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
  color: #777777;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 36rpx;
  letter-spacing: 1rpx;
}

.highlights-section {
  margin-top: 42rpx;
  margin-right: 36rpx;
  margin-left: 36rpx;
}

.highlight-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
  gap: 18rpx 16rpx;
  margin-top: 12rpx;
}

.highlight-item {
  display: block;
  min-width: 0;
  overflow: hidden;
  border-radius: 15rpx;
}

.highlight-image {
  display: block;
  width: 100%;
  overflow: hidden;
  border-radius: 15rpx;
}

.image-pressed {
  opacity: 0.82;
}

.project-section {
  margin-top: 38rpx;
  margin-right: 36rpx;
  margin-left: 36rpx;
}

.project-table {
  margin-top: 16rpx;
  border-top: 1rpx solid #e7e5e2;
}

.project-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 172rpx;
  align-items: center;
  min-height: 40rpx;
  border-bottom: 1rpx solid #e7e5e2;
}

.project-label,
.project-value {
  overflow: hidden;
  font-size: 18rpx;
  font-weight: 400;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-label {
  color: #888888;
}

.project-value {
  color: #333333;
}

.closing-block {
  margin: 38rpx 36rpx 0;
}

.closing-copy {
  margin-top: 4rpx;
  color: #888888;
  font-size: 18rpx;
  font-weight: 400;
  line-height: 30rpx;
  letter-spacing: 1rpx;
}

.detail-action-bar {
  position: fixed;
  z-index: 30;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(250, 249, 247, 0.98);
  border-top: 1rpx solid #deddda;
}

.detail-action-inner {
  display: grid;
  grid-template-columns: 164rpx 446rpx;
  align-items: center;
  column-gap: 20rpx;
  box-sizing: border-box;
  height: 44px;
  padding: 0 36rpx;
}

.favorite-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 44px;
}

.favorite-icon {
  display: block;
  width: 24rpx;
  height: 30rpx;
}

.favorite-label {
  margin-top: 5rpx;
  color: #252525;
  font-size: 16rpx;
  font-weight: 500;
  line-height: 24rpx;
}

.consult-action {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 44px;
  color: #ffffff;
  isolation: isolate;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
  letter-spacing: 1rpx;
}

.consult-action::before {
  position: absolute;
  z-index: 0;
  top: 8px;
  right: 0;
  bottom: 8px;
  left: 0;
  background: #050505;
  border-radius: 999rpx;
  content: "";
}

.consult-action__label {
  position: relative;
  z-index: 1;
}

.consult-action--pressed {
  opacity: 0.76;
}

.tap-soft {
  opacity: 0.58;
}

@media (min-width: 430px) {
  .case-detail,
  .detail-action-bar {
    right: 50%;
    left: auto;
    width: 430px;
    transform: translateX(50%);
  }

  .case-detail {
    margin: 0 auto;
    transform: none;
  }
}
