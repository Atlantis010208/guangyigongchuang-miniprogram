<view class="case-detail">
  <view class="status-space" style="height: {{statusBarHeight}}px;"></view>
  <view class="custom-nav" style="height: {{navigationBarHeight}}px;">
    <button
      class="plain-button back-button"
      bindtap="goBack"
      hover-class="tap-soft"
      aria-label="{{copy.backAria}}"
    >
      <view class="back-chevron" aria-hidden="true"></view>
    </button>
    <view class="nav-title">{{copy.navTitle}}</view>
  </view>

  <view class="detail-content">
    <view wx:if="{{loading}}" class="detail-placeholder">
      <view class="skeleton-hero"></view>
      <view class="skeleton-line skeleton-line--short"></view>
      <view class="skeleton-line skeleton-line--title"></view>
      <view class="skeleton-line skeleton-line--short"></view>
      <view class="placeholder-text">{{copy.loadingText}}</view>
    </view>

    <view wx:elif="{{loadFailed}}" class="detail-placeholder detail-placeholder--empty">
      <view class="empty-title">{{copy.emptyTitle}}</view>
      <view class="empty-hint">{{copy.emptyHint}}</view>
      <button
        class="plain-button empty-retry"
        bindtap="loadDetail"
        hover-class="tap-soft"
      >
        <text class="empty-retry__label">{{copy.retry}}</text>
      </button>
    </view>

    <block wx:else>
      <view wx:if="{{galleryTotal}}" class="hero-wrap">
        <swiper
          class="hero-swiper"
          current="{{currentSlide}}"
          circular
          bindchange="handleSwiperChange"
        >
          <swiper-item wx:for="{{slides}}" wx:key="index">
            <image
              class="hero-image"
              src="{{item.src}}"
              mode="aspectFill"
              fade-in="{{false}}"
              data-index="{{item.index}}"
              bindtap="previewImage"
              aria-label="{{detail.title}}"
            />
          </swiper-item>
        </swiper>
        <view class="slide-counter">
          {{galleryIndex}} / {{galleryTotal}}
        </view>
      </view>

      <view class="intro-block">
        <view wx:if="{{detail.category}}" class="case-category">{{detail.category}}</view>
        <view class="case-title">{{detail.title}}</view>
        <view wx:if="{{detail.meta}}" class="case-meta">{{detail.meta}}</view>
      </view>

      <view wx:if="{{detail.desc}}" class="content-section concept-section">
        <view class="section-title">{{copy.designTitle}}</view>
        <view class="concept-copy">
          <text>{{detail.desc}}</text>
        </view>
      </view>

      <view wx:if="{{highlights.length}}" class="content-section highlights-section">
        <view class="section-title">{{copy.highlightsTitle}}</view>
        <view class="highlight-grid">
          <button
            wx:for="{{highlights}}"
            wx:key="index"
            class="plain-button highlight-item"
            data-index="{{item.index}}"
            bindtap="previewImage"
            hover-class="image-pressed"
            aria-label="{{detail.title}}"
          >
            <image
              class="highlight-image"
              src="{{item.src}}"
              mode="widthFix"
              fade-in="{{false}}"
            />
          </button>
        </view>
      </view>

      <view class="closing-block">
        <view class="closing-title">{{copy.closingTitle}}</view>
        <view class="closing-copy">{{copy.closingText}}</view>
      </view>
    </block>
  </view>

  <view class="detail-action-bar">
    <view class="detail-action-inner">
      <button
        class="plain-button favorite-action"
        bindtap="toggleBookmark"
        hover-class="tap-soft"
        aria-label="{{isBookmarked ? copy.unfavorite : copy.favorite}}"
      >
        <image
          class="favorite-icon"
          src="{{bookmarkIcon}}"
          mode="aspectFit"
          fade-in="{{false}}"
          aria-hidden="true"
        />
        <text class="favorite-label">{{copy.favorite}}</text>
      </button>

      <button
        class="plain-button consult-action"
        bindtap="goConsultation"
        hover-class="consult-action--pressed"
      >
        <text class="consult-action__label">{{copy.consult}}</text>
      </button>
    </view>
  </view>
</view>
