<view class="designer-tools-preview">
  <scroll-view
    class="tools-scroller"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="tools-content">
      <view class="status-space" style="height: {{statusBarHeight}}px;"></view>

      <view class="tools-header" style="height: {{headerHeight}}px;">
        <view class="tools-page-title">{{copy.title}}</view>
        <view class="tools-page-subtitle">{{copy.subtitle}}</view>
      </view>

      <view class="common-section">
        <view class="section-heading">
          <view class="section-title">{{copy.commonTitle}}</view>
          <view class="section-count">{{copy.commonCount}}</view>
        </view>

        <view class="common-card">
          <button
            wx:for="{{commonTools}}"
            wx:key="id"
            class="common-tool"
            data-route="{{item.route}}"
            bindtap="openTool"
            hover-class="tool-pressed"
          >
            <image
              class="common-tool-image"
              src="{{item.image}}"
              mode="aspectFill"
              fade-in="{{false}}"
            />
            <view class="common-tool-copy">
              <view class="common-tool-title">{{item.title}}</view>
              <view class="common-tool-subtitle">{{item.subtitle}}</view>
            </view>
            <image
              class="chevron chevron--common"
              src="cloud://cloud1-5gb9c5u2c58ad6d7.636c-cloud1-5gb9c5u2c58ad6d7-1378684587/ui-v2-assets/pages/v2/designer-workbench/assets/icon-chevron-right-v2.png"
              mode="aspectFit"
              fade-in="{{false}}"
              aria-hidden="true"
            />
          </button>
        </view>
      </view>

      <view class="feature-section">
        <view class="section-title">{{copy.inspirationTitle}}</view>

        <view class="feature-grid">
          <button
            wx:for="{{featureTools}}"
            wx:key="id"
            class="feature-tool"
            data-route="{{item.route}}"
            bindtap="openTool"
            hover-class="tool-pressed"
          >
            <view class="feature-tool-title">{{item.title}}</view>
            <view class="feature-tool-subtitle">{{item.subtitle}}</view>

            <view class="feature-image-wrap">
              <image
                class="feature-tool-image"
                src="{{item.image}}"
                mode="aspectFill"
                fade-in="{{false}}"
              />
              <view wx:if="{{item.badge}}" class="feature-badge">
                {{item.badge}}
              </view>
            </view>

            <view class="feature-action">
              <text>{{item.action}}</text>
              <image
                class="chevron chevron--feature"
                src="cloud://cloud1-5gb9c5u2c58ad6d7.636c-cloud1-5gb9c5u2c58ad6d7-1378684587/ui-v2-assets/pages/v2/designer-workbench/assets/icon-chevron-right-v2.png"
                mode="aspectFit"
                fade-in="{{false}}"
                aria-hidden="true"
              />
            </view>
          </button>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="preview-tabbar">
    <view class="preview-tabbar__inner preview-tabbar__inner--designer-four">
      <button
        wx:for="{{tabs}}"
        wx:key="id"
        class="tab-item {{activeTab === item.id ? 'tab-item--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="switchTab"
        hover-class="none"
      >
        <view class="tab-icon-stack" aria-hidden="true">
          <image
            class="tab-icon-layer {{activeTab !== item.id ? 'tab-icon-layer--visible' : ''}}"
            src="{{item.icon}}"
            mode="aspectFit"
            fade-in="{{false}}"
          />
          <image
            class="tab-icon-layer {{activeTab === item.id ? 'tab-icon-layer--visible' : ''}}"
            src="{{item.activeIcon}}"
            mode="aspectFit"
            fade-in="{{false}}"
          />
        </view>
        <text class="tab-label">{{item.label}}</text>
      </button>
    </view>
  </view>
</view>
