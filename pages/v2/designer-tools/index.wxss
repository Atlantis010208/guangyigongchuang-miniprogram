@import "../shared/preview-tabbar.wxss";

page {
  min-height: 100%;
  color: #111111;
  font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif;
  background: #fafaf9;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  color: inherit;
  font: inherit;
  line-height: inherit;
  background: transparent;
  border: 0;
  border-radius: 0;
}

button::after {
  border: 0;
}

.designer-tools-preview {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #fafaf9;
}

.tools-scroller {
  width: 100%;
  height: 100%;
}

.tools-content {
  box-sizing: border-box;
  min-height: 100%;
  padding-bottom: calc(126rpx + env(safe-area-inset-bottom));
}

.tools-header {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 36rpx;
}

.tools-page-title {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 64rpx;
  letter-spacing: -3rpx;
}

.tools-page-subtitle {
  margin-top: 8rpx;
  color: #66666b;
  font-size: 28rpx;
  line-height: 34rpx;
}

.common-section,
.feature-section {
  margin-right: 36rpx;
  margin-left: 36rpx;
}

.common-section {
  margin-top: 12rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 42rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.section-count {
  color: #67676c;
  font-size: 27rpx;
  line-height: 36rpx;
}

.common-card {
  margin-top: 14rpx;
  padding: 0 20rpx;
  background: #ffffff;
  border: 1rpx solid #e1e1e1;
  border-radius: 18rpx;
}

.common-tool {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 184rpx;
  text-align: left;
}

.common-tool + .common-tool {
  border-top: 1rpx solid #e9e9e9;
}

.common-tool-image {
  display: block;
  flex: 0 0 auto;
  width: 232rpx;
  height: 132rpx;
  background: #f1f1ef;
  border-radius: 12rpx;
}

.common-tool-copy {
  min-width: 0;
  margin-left: 34rpx;
}

.common-tool-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.common-tool-subtitle {
  margin-top: 6rpx;
  color: #66666b;
  font-size: 26rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.chevron {
  display: block;
  flex: 0 0 auto;
}

.chevron--common {
  width: 24rpx;
  height: 32rpx;
  margin-left: auto;
}

.feature-section {
  margin-top: 30rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 14rpx;
}

.feature-tool {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 448rpx;
  padding: 20rpx 20rpx 12rpx;
  text-align: left;
  background: #ffffff;
  border: 1rpx solid #e1e1e1;
  border-radius: 18rpx;
}

.feature-tool-title {
  font-size: 33rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.feature-tool-subtitle {
  min-height: 68rpx;
  margin-top: 5rpx;
  color: #66666b;
  font-size: 25rpx;
  line-height: 32rpx;
}

.feature-image-wrap {
  position: relative;
  width: 100%;
  height: 272rpx;
  margin-top: 14rpx;
  overflow: hidden;
  background: #f1f1ef;
  border-radius: 12rpx;
}

.feature-tool-image {
  display: block;
  width: 100%;
  height: 100%;
}

.feature-badge {
  position: absolute;
  bottom: 10rpx;
  left: 10rpx;
  padding: 4rpx 10rpx;
  color: #111111;
  font-size: 22rpx;
  line-height: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  border-radius: 999rpx;
}

.feature-action {
  display: flex;
  align-items: center;
  min-height: 52rpx;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.chevron--feature {
  width: 22rpx;
  height: 28rpx;
  margin-left: 12rpx;
}

.tool-pressed,
.tap-soft {
  opacity: 0.58;
}

@media (min-width: 430px) {
  .designer-tools-preview {
    width: 430px;
    margin: 0 auto;
  }
}
