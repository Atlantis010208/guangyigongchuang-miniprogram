@import "../shared/preview-tabbar.wxss";

page {
  min-height: 100%;
  color: #111111;
  font-family: "PingFang SC", "Noto Sans CJK SC";
  background: #fafaf9;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  color: inherit;
  font: inherit;
  line-height: inherit;
  text-align: left;
  background: transparent;
  border: 0;
  border-radius: 0;
}

button::after {
  border: 0;
}

.designer-profile-preview {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #fafaf9;
}

.designer-profile-preview--login,
.designer-profile-preview--login .profile-content {
  background: #ffffff;
}

.profile-scroller {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-content {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(108rpx + env(safe-area-inset-bottom));
}

.status-space,
.profile-header {
  position: relative;
  z-index: 2;
}

.profile-heading {
  position: absolute;
  top: 12px;
  left: 30rpx;
}

.profile-header--login {
  height: 118px !important;
}

.profile-heading--center {
  top: 22px;
  right: 30rpx;
  left: 30rpx;
  text-align: center;
}

.profile-heading--center .profile-page-title {
  font-size: 38rpx;
  line-height: 48rpx;
  letter-spacing: 0;
}

.profile-heading--center .profile-page-subtitle {
  font-size: 24rpx;
  line-height: 34rpx;
  letter-spacing: 0;
}

.profile-page-title {
  color: #050505;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 68rpx;
  letter-spacing: 1rpx;
}

.profile-page-subtitle {
  color: #707074;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  letter-spacing: 1rpx;
}

.designer-login-panel {
  box-sizing: border-box;
  min-height: calc(100vh - 118px - 108rpx - env(safe-area-inset-bottom));
  padding: 4rpx 48rpx 64rpx;
}

.designer-checking-panel {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  min-height: calc(100vh - 118px - 108rpx - env(safe-area-inset-bottom));
  padding: 4rpx 48rpx 64rpx;
}

.designer-checking-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  min-height: 420rpx;
  padding: 84rpx 48rpx 70rpx;
  background: #ffffff;
  border: 1rpx solid #ececec;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.018);
}

.checking-spinner {
  box-sizing: border-box;
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid #eeeeee;
  border-top-color: #000000;
  border-radius: 50%;
  animation: checking-spin 0.9s linear infinite;
}

.checking-title {
  margin-top: 34rpx;
  color: #000000;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 46rpx;
  text-align: center;
}

.checking-subtitle {
  max-width: 420rpx;
  margin-top: 16rpx;
  color: #777777;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.checking-progress {
  width: 220rpx;
  height: 6rpx;
  margin-top: 34rpx;
  overflow: hidden;
  background: #eeeeee;
  border-radius: 999rpx;
}

.checking-progress-fill {
  width: 45%;
  height: 100%;
  background: #000000;
  border-radius: inherit;
  animation: checking-progress 1.2s ease-in-out infinite;
}

.checking-hint {
  max-width: 430rpx;
  margin-top: 30rpx;
  color: #9a9a9a;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.designer-login-card {
  box-sizing: border-box;
  width: 100%;
  height: 814rpx;
  padding: 82rpx 48rpx 0;
  background: #ffffff;
  border: 1rpx solid #ececec;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.018);
}

.designer-login-title {
  color: #000000;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 50rpx;
  text-align: center;
}

.designer-login-subtitle {
  width: 100%;
  max-width: 100%;
  margin: 14rpx auto 0;
  color: #7d7d7d;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.login-avatar-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 190rpx;
  min-height: 204rpx;
  margin: 30rpx auto 0;
  text-align: center;
}

.login-avatar-image,
.login-avatar-empty {
  width: 154rpx;
  height: 154rpx;
  overflow: hidden;
  border-radius: 50%;
}

.login-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #ffffff;
  border: 2rpx solid #d8d8d8;
}

.login-camera-icon {
  display: block;
  width: 76rpx;
  height: 76rpx;
}

.login-avatar-label {
  margin-top: 14rpx;
  color: #6f6f6f;
  font-size: 24rpx;
  line-height: 34rpx;
}

.login-form {
  margin-top: 12rpx;
}

.login-field {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 124rpx;
  column-gap: 18rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.login-field-label {
  flex: none;
  width: 124rpx;
  color: #000000;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.login-field-input {
  width: auto;
  min-width: 0;
  height: 92rpx;
  padding: 0;
  flex: 1;
  color: #111111;
  font-size: 26rpx;
  line-height: 92rpx;
  text-align: left;
}

.login-field-placeholder,
.login-field-value--empty {
  color: #a3a3a3;
}

.login-field-value {
  min-width: 0;
  flex: 1;
  color: #111111;
  font-size: 26rpx;
  line-height: 36rpx;
  white-space: nowrap;
}

.login-phone-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 160rpx;
  height: 58rpx;
  color: #000000;
  font-size: 23rpx;
  font-weight: 500;
  text-align: center;
  background: #ffffff;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
}

.login-phone-button--done {
  color: #111111;
  background: #ffffff;
  border-color: #111111;
}

.login-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  color: #858585;
  font-size: 21rpx;
  line-height: 30rpx;
  text-align: center;
}

.login-meta-icon {
  display: block;
  flex: none;
  width: 24rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.login-confirm-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 400rpx;
  height: 84rpx;
  margin: 68rpx auto 0;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 84rpx;
  text-align: center;
  background: #000000;
  border-radius: 999rpx;
}

.login-confirm-button[disabled] {
  color: rgba(255, 255, 255, 0.72);
  background: #2d2d2d;
}

.login-later-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  margin: 36rpx auto 0;
  color: #858585;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.identity-card {
  box-sizing: border-box;
  height: 308rpx;
  margin: 0 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #dfdfdf;
  border-radius: 20rpx;
}

.identity-top {
  position: relative;
  display: grid;
  grid-template-columns: 154rpx minmax(0, 1fr);
  column-gap: 28rpx;
  box-sizing: border-box;
  height: 216rpx;
  padding: 22rpx 24rpx 0;
}

.profile-avatar {
  display: block;
  width: 154rpx;
  height: 154rpx;
  overflow: hidden;
  border-radius: 50%;
}

.profile-avatar--empty {
  background: #f1f1ef;
}

.identity-copy {
  min-width: 0;
  padding-top: 4rpx;
  padding-right: 112rpx;
}

.identity-role {
  color: #090909;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.identity-profession {
  margin-top: 5rpx;
  color: #606167;
  font-size: 24rpx;
  line-height: 34rpx;
}

.mode-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 34rpx;
  margin-top: 8rpx;
  padding: 0 16rpx;
  color: #3478f6;
  font-size: 20rpx;
  font-weight: 500;
  border: 2rpx solid #3478f6;
  border-radius: 10rpx;
}

.identity-intro {
  overflow: hidden;
  margin-top: 10rpx;
  color: #606167;
  font-size: 21rpx;
  line-height: 31rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-profile {
  position: absolute;
  top: 28rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 106rpx;
  height: 44px;
  color: #5f6065;
  font-size: 21rpx;
}

.chevron {
  display: block;
  flex: none;
  opacity: 0.78;
}

.chevron--edit {
  width: 14rpx;
  height: 14rpx;
  margin-left: 14rpx;
}

.identity-divider {
  height: 1rpx;
  margin: 0 24rpx;
  background: #e1e1e1;
}

.profile-shortcuts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  height: 91rpx;
}

.profile-shortcut {
  position: relative;
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr);
  column-gap: 16rpx;
  align-items: center;
  min-width: 0;
  min-height: 44px;
  padding: 0 34rpx;
}

.profile-shortcut + .profile-shortcut::before {
  position: absolute;
  top: 20rpx;
  bottom: 20rpx;
  left: 0;
  width: 1rpx;
  background: #dedede;
  content: "";
}

.id-card-glyph {
  position: relative;
  box-sizing: border-box;
  width: 42rpx;
  height: 52rpx;
  margin-left: 5rpx;
  border: 4rpx solid #111111;
  border-radius: 7rpx;
}

.id-card-glyph__head {
  position: absolute;
  top: 8rpx;
  left: 12rpx;
  box-sizing: border-box;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #111111;
  border-radius: 50%;
}

.id-card-glyph__body {
  position: absolute;
  top: 23rpx;
  left: 8rpx;
  box-sizing: border-box;
  width: 20rpx;
  height: 12rpx;
  border: 3rpx solid #111111;
  border-bottom: 0;
  border-radius: 12rpx 12rpx 0 0;
}

.id-card-glyph__line {
  position: absolute;
  right: 8rpx;
  bottom: 7rpx;
  left: 8rpx;
  height: 2rpx;
  background: #111111;
  border-radius: 999rpx;
}

.home-glyph {
  position: relative;
  width: 52rpx;
  height: 52rpx;
}

.home-glyph__roof {
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  box-sizing: border-box;
  width: 36rpx;
  height: 36rpx;
  border-top: 4rpx solid #111111;
  border-left: 4rpx solid #111111;
  transform: rotate(45deg);
  transform-origin: center;
}

.home-glyph__body {
  position: absolute;
  right: 8rpx;
  bottom: 3rpx;
  left: 8rpx;
  box-sizing: border-box;
  height: 31rpx;
  background: #ffffff;
  border: 4rpx solid #111111;
  border-top: 0;
  border-radius: 0 0 5rpx 5rpx;
}

.shortcut-copy {
  min-width: 0;
}

.shortcut-title {
  overflow: hidden;
  color: #111111;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shortcut-subtitle {
  overflow: hidden;
  color: #707074;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.works-section {
  margin: 38rpx 36rpx 0;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 50rpx;
}

.section-title {
  color: #0b0b0b;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.section-action {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 112rpx;
  height: 44px;
  color: #5f6065;
  font-size: 21rpx;
}

.chevron--section {
  width: 14rpx;
  height: 14rpx;
  margin-left: 14rpx;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 18rpx;
  margin-top: 12rpx;
}

.work-item {
  min-width: 0;
}

.work-image {
  display: block;
  width: 100%;
  height: 196rpx;
  overflow: hidden;
  border-radius: 17rpx;
}

.work-label {
  margin-top: 10rpx;
  color: #111111;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.works-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 96rpx;
  margin-top: 12rpx;
  color: #8b8b90;
  font-size: 22rpx;
  line-height: 32rpx;
  border: 1rpx solid #e2e2e2;
  border-radius: 18rpx;
}

.settings-section {
  margin: 40rpx 28rpx 0;
}

.settings-section > .section-title {
  margin-left: 8rpx;
}

.settings-card {
  height: 164rpx;
  margin-top: 12rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #dfdfdf;
  border-radius: 20rpx;
}

.setting-item {
  position: relative;
  display: grid;
  grid-template-columns: 60rpx minmax(0, 1fr) 18rpx;
  column-gap: 16rpx;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  height: 82rpx;
  padding: 0 24rpx;
}

.setting-item + .setting-item::before {
  position: absolute;
  top: 0;
  right: 24rpx;
  left: 24rpx;
  height: 1rpx;
  background: #e1e1e1;
  content: "";
}

.setting-item--pressed {
  background: #f4f4f2;
}

.person-glyph,
.bell-glyph {
  position: relative;
  width: 52rpx;
  height: 52rpx;
}

.person-glyph__head {
  position: absolute;
  top: 1rpx;
  left: 15rpx;
  box-sizing: border-box;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #111111;
  border-radius: 50%;
}

.person-glyph__body {
  position: absolute;
  right: 4rpx;
  bottom: 1rpx;
  left: 4rpx;
  box-sizing: border-box;
  height: 26rpx;
  border: 3rpx solid #111111;
  border-bottom: 0;
  border-radius: 26rpx 26rpx 0 0;
}

.bell-glyph__body {
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  box-sizing: border-box;
  width: 36rpx;
  height: 38rpx;
  border: 3rpx solid #111111;
  border-radius: 20rpx 20rpx 9rpx 9rpx;
}

.bell-glyph__body::before {
  position: absolute;
  top: -7rpx;
  left: 13rpx;
  width: 6rpx;
  height: 8rpx;
  background: #111111;
  border-radius: 999rpx;
  content: "";
}

.bell-glyph__clapper {
  position: absolute;
  bottom: 1rpx;
  left: 22rpx;
  width: 8rpx;
  height: 5rpx;
  background: #111111;
  border-radius: 0 0 999rpx 999rpx;
}

.setting-copy {
  min-width: 0;
}

.setting-title {
  overflow: hidden;
  color: #111111;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.setting-subtitle {
  overflow: hidden;
  color: #707074;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chevron--setting {
  width: 14rpx;
  height: 14rpx;
}

.owner-entry-section {
  margin: 18rpx 28rpx 0;
}

.owner-entry-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 92rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #dfdfdf;
  border-radius: 20rpx;
}

.owner-entry-card[disabled] {
  opacity: 0.68;
}

.owner-entry-content {
  position: absolute;
  top: 0;
  right: 24rpx;
  bottom: 0;
  left: 24rpx;
  display: grid;
  grid-template-columns: 60rpx minmax(0, 1fr) 18rpx;
  column-gap: 16rpx;
  align-items: center;
  pointer-events: none;
}

.owner-entry-card--loading .owner-entry-content {
  opacity: 0;
}

.owner-entry-glyph {
  transform: scale(0.86);
  transform-origin: left center;
}

.owner-entry-copy {
  min-width: 0;
}

.owner-entry-title {
  overflow: hidden;
  color: #111111;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.owner-entry-subtitle {
  overflow: hidden;
  color: #707074;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.completeness-note {
  margin: 18rpx 28rpx 26rpx;
  color: #6b6b70;
  font-size: 19rpx;
  line-height: 30rpx;
  text-align: center;
}

.designer-profile-preview .tab-label {
  font-size: 22rpx;
  line-height: 30rpx;
}

.tap-soft {
  opacity: 0.58;
}

@keyframes checking-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes checking-progress {
  0% {
    transform: translateX(-120%);
  }

  100% {
    transform: translateX(260%);
  }
}

@media (min-height: 760px) {
  .identity-card {
    height: 348rpx;
  }

  .identity-top {
    height: 236rpx;
  }

  .profile-shortcuts {
    height: 111rpx;
  }

  .works-section {
    margin-top: 78rpx;
  }

  .work-image {
    height: 236rpx;
  }

  .settings-section {
    margin-top: 80rpx;
  }

  .settings-card {
    height: 196rpx;
  }

  .setting-item {
    height: 98rpx;
  }

  .owner-entry-section {
    margin-top: 22rpx;
  }

  .owner-entry-card {
    height: 104rpx;
  }

  .completeness-note {
    margin-top: 32rpx;
    margin-bottom: 48rpx;
  }
}
@media (max-width: 340px) {
  .identity-card {
    height: 320rpx;
  }

  .identity-copy {
    padding-right: 96rpx;
  }

  .profile-shortcut {
    padding-right: 20rpx;
    padding-left: 20rpx;
  }

  .shortcut-title {
    font-size: 22rpx;
  }
}

@media (min-width: 430px) {
  .designer-profile-preview {
    max-width: 430px;
    margin: 0 auto;
    box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.03);
  }
}
