@import "../shared/preview-tabbar.wxss";

page {
  min-height: 100%;
  color: #111111;
  font-family: "PingFang SC", "Noto Sans CJK SC";
  background: #fafaf9;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  color: inherit;
  font: inherit;
  line-height: inherit;
  text-align: left;
  background: transparent;
  border: 0;
  border-radius: 0;
}

button::after {
  border: 0;
}

.designer-workbench {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #fafaf9;
}

.workbench-scroller {
  display: block;
  width: 100%;
  height: 100%;
}

.workbench-content {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(108rpx + env(safe-area-inset-bottom));
}

.status-space {
  position: relative;
  z-index: 2;
}

.workbench-header {
  position: relative;
  z-index: 2;
}

.avatar-button {
  position: absolute;
  top: 26px;
  left: 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  width: 60px;
  height: 44px;
}

.avatar-image {
  display: block;
  width: 70rpx;
  height: 70rpx;
  overflow: hidden;
  background: #efefed;
  border-radius: 50%;
}

.workbench-heading {
  position: absolute;
  top: 15px;
  left: 120rpx;
}

.workbench-title {
  color: #050505;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 62rpx;
  letter-spacing: 1rpx;
}

.pending-summary {
  color: #777777;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  letter-spacing: 1rpx;
}

.summary-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  height: 88rpx;
  padding: 0 30rpx;
}

.summary-metric {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.summary-metric + .summary-metric::before {
  position: absolute;
  top: 14rpx;
  bottom: 14rpx;
  left: 0;
  width: 1rpx;
  background: #d9d9d9;
  content: "";
}

.summary-label {
  color: #666666;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.summary-value {
  color: #090909;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 50rpx;
}

.next-action-card {
  position: relative;
  margin-top: 4rpx;
  z-index: 2;
  box-sizing: border-box;
  width: calc(100% - 56rpx);
  height: 356rpx;
  margin-right: 28rpx;
  margin-left: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #eeeeed;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.055);
}

.next-action-copy {
  position: absolute;
  top: 28rpx;
  left: 30rpx;
  z-index: 2;
}

.next-eyebrow {
  color: #686868;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.next-title-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.next-title {
  color: #111111;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
  white-space: nowrap;
}

.next-tag {
  display: flex;
  align-items: center;
  height: 34rpx;
  margin-left: 12rpx;
  padding: 0 12rpx;
  color: #3478f6;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 30rpx;
  white-space: nowrap;
  background: #edf3ff;
  border-radius: 999rpx;
}

.next-task {
  margin-top: 4rpx;
  color: #111111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 46rpx;
  letter-spacing: 1rpx;
}

.next-deadline {
  color: #777777;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.next-project-image {
  position: absolute;
  z-index: 1;
  top: 28rpx;
  right: 28rpx;
  display: block;
  width: 164rpx;
  height: 164rpx;
  overflow: hidden;
  border-radius: 22rpx;
}

.next-progress {
  position: absolute;
  top: 204rpx;
  left: 30rpx;
  width: 354rpx;
}

.progress-copy,
.project-progress-copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #666666;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.progress-track,
.project-progress-track {
  position: relative;
  overflow: hidden;
  background: #e4e5e7;
  border-radius: 999rpx;
}

.progress-track {
  height: 8rpx;
  margin-top: 8rpx;
}

.progress-fill,
.project-progress-fill {
  height: 100%;
  background: #3478f6;
  border-radius: inherit;
}

.next-action-buttons {
  position: absolute;
  right: 30rpx;
  bottom: 12rpx;
  left: 30rpx;
  display: grid;
  grid-template-columns: 356rpx minmax(0, 1fr);
  column-gap: 16rpx;
  height: 44px;
}

.next-action-primary,
.next-action-secondary {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 44px;
}

.next-action-primary {
  height: 44px;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  isolation: isolate;
}

.next-action-primary::before {
  position: absolute;
  z-index: 0;
  top: 9px;
  right: 0;
  bottom: 8px;
  left: 0;
  background: #050505;
  border-radius: 999rpx;
  content: "";
}

.next-action-primary__label {
  position: relative;
  z-index: 1;
}

.next-action-primary--pressed {
  opacity: 0.76;
}

.next-action-secondary {
  height: 44px;
  color: #1c1c1c;
  font-size: 24rpx;
  font-weight: 500;
}

.chevron {
  display: block;
  flex: none;
  opacity: 0.72;
}

.chevron--action {
  width: 16rpx;
  height: 16rpx;
  margin-left: 24rpx;
  opacity: 0.88;
}

.today-todo-section,
.ongoing-projects-section,
.quick-tools-section {
  margin-right: 28rpx;
  margin-left: 28rpx;
}

.today-todo-section {
  margin-top: 26rpx;
}

.ongoing-projects-section {
  margin-top: 24rpx;
}

.quick-tools-section {
  margin-top: 20rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  height: 40rpx;
  padding: 0 8rpx;
}

.section-title {
  color: #0c0c0c;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.section-more {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 130rpx;
  height: 44px;
  color: #666666;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.chevron--small {
  width: 14rpx;
  height: 14rpx;
  margin-right: 2rpx;
  margin-left: 12rpx;
  opacity: 0.58;
}

.todo-list {
  position: relative;
  display: grid;
  grid-template-rows: repeat(2, minmax(44px, 1fr));
  z-index: 3;
  height: 176rpx;
  min-height: 88px;
  overflow: hidden;
  margin-top: 0;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #dfdfdf;
  border-radius: 16rpx;
}

.todo-item {
  position: relative;
  display: grid;
  grid-template-columns: 22rpx minmax(0, 1fr) 72rpx 20rpx;
  align-items: center;
  min-height: 44px;
  padding: 0 22rpx;
}


.todo-item + .todo-item::before {
  position: absolute;
  top: 0;
  right: 22rpx;
  left: 22rpx;
  height: 1rpx;
  background: #e2e2e2;
  content: "";
}

.todo-item--pressed {
  background: #f5f5f3;
}

.todo-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.todo-dot--dark {
  background: #050505;
}

.todo-dot--blue {
  background: #3478f6;
}

.todo-copy {
  min-width: 0;
  margin-left: 16rpx;
}

.todo-title {
  overflow: hidden;
  color: #111111;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-subtitle {
  color: #777777;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 26rpx;
}

.todo-time {
  color: #666666;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
  text-align: right;
}

.chevron--todo {
  width: 14rpx;
  height: 14rpx;
  margin-left: 8rpx;
  opacity: 0.72;
}

.project-grid {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 18rpx;
  margin-top: 4rpx;
}

.project-card {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr);
  column-gap: 18rpx;
  align-items: center;
  min-width: 0;
  height: 142rpx;
  padding: 16rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e2e2e2;
  border-radius: 18rpx;
}

.project-card--pressed {
  background: #f5f5f3;
}

.project-image {
  display: block;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.project-copy {
  min-width: 0;
}

.project-title {
  overflow: hidden;
  color: #111111;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-tag {
  display: inline-flex;
  align-items: center;
  height: 30rpx;
  margin-top: 2rpx;
  padding: 0 10rpx;
  color: #3478f6;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 26rpx;
  background: #edf3ff;
  border-radius: 999rpx;
}

.project-progress-copy {
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 24rpx;
}

.project-progress-track {
  height: 6rpx;
  margin-top: 4rpx;
}

.quick-tool-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  height: 94rpx;
  margin-top: 4rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #dfdfdf;
  border-radius: 20rpx;
}

.quick-tool {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 44px;
}

.quick-tool + .quick-tool::before {
  position: absolute;
  top: 16rpx;
  bottom: 16rpx;
  left: 0;
  width: 1rpx;
  background: #dcdcdc;
  content: "";
}

.quick-tool--pressed {
  background: #f5f5f3;
}

.quick-tool-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
  opacity: 0.92;
}

.quick-tool-label {
  margin-top: 4rpx;
  color: #555555;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 26rpx;
}

.designer-workbench .tab-label {
  font-size: 22rpx;
  line-height: 30rpx;
}

.tap-soft {
  opacity: 0.58;
}

@media (min-width: 430px) {
  .designer-workbench {
    max-width: 430px;
    margin: 0 auto;
    box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.03);
  }
}
