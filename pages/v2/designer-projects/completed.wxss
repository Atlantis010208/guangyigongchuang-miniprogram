.completed-search{position:relative;display:flex;align-items:center;box-sizing:border-box;height:68rpx;margin:24rpx 28rpx 0;padding:0 22rpx;background:#f5f5f5;border:1rpx solid #e8e8e8;border-radius:20rpx}
.completed-search-glyph{position:relative;box-sizing:border-box;flex:none;width:26rpx;height:26rpx;border:3rpx solid #777981;border-radius:50%}
.completed-search-glyph::after{position:absolute;right:-10rpx;bottom:-7rpx;width:12rpx;height:3rpx;background:#777981;border-radius:999rpx;transform:rotate(45deg);transform-origin:left center;content:""}
.completed-input{box-sizing:border-box;flex:1;height:44px;margin-left:20rpx;color:#151515;font-size:23rpx;line-height:44px}.completed-placeholder{color:#96979d}
.completed-heading{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;height:50rpx;margin:24rpx 28rpx 0;padding:0 4rpx}
.completed-sort{display:flex;align-items:center;justify-content:flex-end;min-width:150rpx;height:44px;color:#55565b;font-size:22rpx}
.chevron--completed-sort,.chevron--completed-action,.chevron--history{width:15rpx;height:15rpx;margin-left:16rpx}.chevron--ascending{transform:rotate(180deg)}
.completed-list{margin-top:10rpx}.completed-card{box-sizing:border-box;width:calc(100% - 56rpx);height:428rpx;margin:0 28rpx;overflow:hidden;background:rgba(255,255,255,.98);border:1rpx solid #dfdfdf;border-radius:20rpx}.completed-card+.completed-card{margin-top:16rpx}
.completed-card__top{display:grid;grid-template-columns:200rpx minmax(0,1fr);column-gap:28rpx;box-sizing:border-box;height:204rpx;padding:22rpx 22rpx 0}.completed-image{display:block;width:200rpx;height:170rpx;overflow:hidden;border-radius:18rpx}.completed-summary{min-width:0;padding-top:4rpx}
.completed-title{overflow:hidden;color:#0a0a0a;font-size:29rpx;font-weight:600;line-height:42rpx;text-overflow:ellipsis;white-space:nowrap}.completed-meta,.completed-description{overflow:hidden;color:#66676d;font-size:22rpx;line-height:32rpx;text-overflow:ellipsis;white-space:nowrap}.completed-meta{margin-top:5rpx}.completed-description{margin-top:9rpx}
.completed-tag,.settled-tag{display:inline-flex;align-items:center;justify-content:center;height:34rpx;padding:0 14rpx;color:#596170;font-size:20rpx;line-height:30rpx;background:#eef0f4;border-radius:999rpx}.completed-tag{margin-top:10rpx}.settled-tag{height:30rpx;margin-top:2rpx;font-size:18rpx}
.completed-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));box-sizing:border-box;height:82rpx;margin:0 22rpx;border-top:1rpx solid #e2e2e2;border-bottom:1rpx solid #e2e2e2}.completed-metric{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0}.completed-metric+.completed-metric::before{position:absolute;top:18rpx;bottom:18rpx;left:0;width:1rpx;background:#e2e2e2;content:""}.completed-metric__label{color:#66676d;font-size:20rpx;line-height:28rpx}.completed-metric__value{color:#161616;font-size:23rpx;font-weight:500;line-height:34rpx}
.completed-delivery{display:grid;grid-template-columns:32rpx minmax(0,1fr);column-gap:14rpx;align-items:center;box-sizing:border-box;height:54rpx;padding:0 24rpx}.completed-delivery .document-glyph{width:25rpx;height:29rpx}.completed-delivery__text{overflow:hidden;color:#606168;font-size:21rpx;line-height:30rpx;text-overflow:ellipsis;white-space:nowrap}
.completed-actions{display:grid;grid-template-columns:190rpx minmax(0,1fr);column-gap:28rpx;align-items:center;box-sizing:border-box;height:88rpx;padding:0 22rpx}.completed-detail,.completed-files{display:flex;align-items:center;height:44px;color:#111;font-size:23rpx;font-weight:500}.completed-detail{justify-content:flex-start}.completed-files{position:relative;justify-self:end;justify-content:center;width:230rpx;isolation:isolate}.completed-files::before{position:absolute;z-index:-1;top:7px;right:0;bottom:7px;left:0;border:2rpx solid #111;border-radius:999rpx;content:""}
.completed-empty{display:flex;align-items:center;justify-content:center;height:180rpx;margin:10rpx 28rpx 0;color:#77777b;font-size:22rpx;border:1rpx solid #e1e1e1;border-radius:20rpx}
.completed-history{box-sizing:border-box;height:154rpx;margin:16rpx 28rpx 0;overflow:hidden;background:rgba(255,255,255,.98);border:1rpx solid #dfdfdf;border-radius:20rpx}.completed-history__item{display:grid;grid-template-columns:54rpx minmax(0,1fr) 24rpx;column-gap:18rpx;align-items:center;box-sizing:border-box;width:100%;height:76rpx;padding:0 24rpx}.completed-history__item+.completed-history__item{border-top:1rpx solid #e2e2e2}.completed-history__copy{min-width:0}.completed-history__title{color:#111;font-size:24rpx;font-weight:600;line-height:32rpx}.completed-history__subtitle{color:#6b6c71;font-size:20rpx;line-height:28rpx}
.folder-glyph{position:relative;box-sizing:border-box;width:46rpx;height:34rpx;border:3rpx solid #171717;border-radius:5rpx}.folder-glyph__tab{position:absolute;top:-10rpx;left:-3rpx;box-sizing:border-box;width:24rpx;height:10rpx;border:3rpx solid #171717;border-bottom:0;border-radius:5rpx 5rpx 0 0}.chevron--history{margin-left:0}.completed-note{display:flex;align-items:center;box-sizing:border-box;min-height:60rpx;margin:0 28rpx 12rpx;padding:0 12rpx;color:#65666b;font-size:20rpx;line-height:30rpx}