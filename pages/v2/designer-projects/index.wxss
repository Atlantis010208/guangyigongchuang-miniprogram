@import "../shared/preview-tabbar.wxss";
@import "./completed.wxss";

page {
  min-height: 100%;
  color: #111111;
  font-family: "PingFang SC", "Noto Sans CJK SC";
  background: #fafaf9;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  color: inherit;
  font: inherit;
  line-height: inherit;
  text-align: left;
  background: transparent;
  border: 0;
  border-radius: 0;
}

button::after {
  border: 0;
}

.designer-projects-preview {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #fafaf9;
}

.projects-scroller {
  display: block;
  width: 100%;
  height: 100%;
}

.projects-content {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(108rpx + env(safe-area-inset-bottom));
}

.status-space,
.projects-header {
  position: relative;
  z-index: 2;
}

.projects-heading {
  position: absolute;
  top: 12px;
  left: 30rpx;
}

.projects-title {
  color: #050505;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 68rpx;
  letter-spacing: 1rpx;
}

.projects-subtitle {
  color: #707074;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  letter-spacing: 1rpx;
}


.category-tabs {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  box-sizing: border-box;
  height: 72rpx;
  margin: 0 28rpx;
  overflow: visible;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #dedede;
  border-radius: 20rpx;
}

.category-tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 44px;
  margin-top: -4px;
  color: #707074;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.category-tab--active {
  color: #101010;
  font-weight: 600;
}

.category-indicator {
  position: absolute;
  right: 42rpx;
  bottom: 4px;
  left: 42rpx;
  height: 5rpx;
  background: #090909;
  border-radius: 999rpx;
}

.project-stats {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  box-sizing: border-box;
  height: 112rpx;
  margin: 24rpx 28rpx 0;
  padding: 18rpx 0;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #e1e1e1;
  border-radius: 20rpx;
}

.project-stat {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.project-stat + .project-stat::before {
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  left: 0;
  width: 1rpx;
  background: #d9d9d9;
  content: "";
}

.stat-label {
  color: #66666b;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.stat-value {
  color: #050505;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 46rpx;
}

.projects-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  height: 44rpx;
  margin: 28rpx 28rpx 0;
  padding: 0 4rpx;
}

.section-title {
  color: #0a0a0a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.section-more {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 124rpx;
  height: 44px;
  color: #66666b;
  font-size: 22rpx;
  font-weight: 400;
}

.chevron {
  display: block;
  flex: none;
  opacity: 0.78;
}

.chevron--section {
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
}

.project-list {
  margin-top: 8rpx;
}

.project-card {
  position: relative;
  box-sizing: border-box;
  width: calc(100% - 56rpx);
  margin-right: 28rpx;
  margin-left: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #e1e1e1;
  border-radius: 20rpx;
}

.project-card--primary {
  height: 440rpx;
}

.project-card--secondary {
  height: 376rpx;
  margin-top: 14rpx;
}

.project-card__top {
  display: grid;
  grid-template-columns: 176rpx minmax(0, 1fr);
  column-gap: 28rpx;
  box-sizing: border-box;
  height: 196rpx;
  padding: 20rpx 20rpx 0;
}

.project-image {
  display: block;
  width: 176rpx;
  height: 176rpx;
  overflow: hidden;
  border-radius: 18rpx;
}

.project-summary {
  min-width: 0;
  padding-top: 6rpx;
}

.project-title {
  overflow: hidden;
  color: #0b0b0b;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-meta {
  overflow: hidden;
  margin-top: 6rpx;
  color: #68686d;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-tag {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  margin-top: 14rpx;
  padding: 0 14rpx;
  color: #3478f6;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 30rpx;
  background: #edf3ff;
  border-radius: 999rpx;
}

.project-divider {
  height: 1rpx;
  margin: 0 20rpx;
  background: #e1e1e1;
}

.project-task {
  box-sizing: border-box;
  padding: 12rpx 20rpx 0;
}

.task-eyebrow {
  color: #66666b;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.task-title {
  color: #101010;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.task-deadline {
  color: #66666b;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.project-progress {
  width: 380rpx;
  margin-top: 8rpx;
}

.progress-copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #66666b;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.progress-track {
  position: relative;
  height: 7rpx;
  margin-top: 4rpx;
  overflow: hidden;
  background: #e2e3e6;
  border-radius: 999rpx;
}

.progress-fill {
  height: 100%;
  background: #3478f6;
  border-radius: inherit;
}

.project-actions {
  position: absolute;
  right: 20rpx;
  bottom: 0;
  left: 20rpx;
  display: grid;
  grid-template-columns: 280rpx minmax(0, 1fr);
  column-gap: 20rpx;
  height: 44px;
}

.project-actions--single {
  display: flex;
  justify-content: flex-end;
}

.primary-action,
.detail-action {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 44px;
}

.primary-action {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  isolation: isolate;
}

.primary-action::before {
  position: absolute;
  z-index: 0;
  top: 8px;
  right: 0;
  bottom: 8px;
  left: 0;
  background: #050505;
  border-radius: 999rpx;
  content: "";
}

.primary-action__label {
  position: relative;
  z-index: 1;
}

.primary-action--pressed {
  opacity: 0.76;
}

.detail-action {
  justify-self: end;
  justify-content: flex-end;
  width: 152rpx;
  color: #151515;
  font-size: 22rpx;
  font-weight: 500;
}

.project-actions--single .detail-action {
  width: 152rpx;
}

.chevron--action {
  width: 15rpx;
  height: 15rpx;
  margin-left: 18rpx;
}

.management-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  box-sizing: border-box;
  height: 104rpx;
  margin: 18rpx 28rpx 0;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #e1e1e1;
  border-radius: 20rpx;
}

.management-item {
  position: relative;
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr) 18rpx;
  column-gap: 14rpx;
  align-items: center;
  min-width: 0;
  min-height: 44px;
  padding: 0 20rpx;
}

.management-item + .management-item::before {
  position: absolute;
  top: 18rpx;
  bottom: 18rpx;
  left: 0;
  width: 1rpx;
  background: #dedede;
  content: "";
}

.management-item--pressed {
  background: #f4f4f2;
}

.management-icon {
  display: block;
  width: 56rpx;
  height: 52rpx;
  opacity: 0.9;
}

.wallet-glyph {
  position: relative;
  box-sizing: border-box;
  width: 54rpx;
  height: 42rpx;
  border: 4rpx solid #171717;
  border-radius: 8rpx;
}

.wallet-glyph__flap {
  position: absolute;
  top: 11rpx;
  right: -4rpx;
  width: 23rpx;
  height: 16rpx;
  background: #fafaf9;
  border: 4rpx solid #171717;
  border-right: 0;
  border-radius: 6rpx 0 0 6rpx;
}

.wallet-glyph__dot {
  position: absolute;
  top: 17rpx;
  right: 8rpx;
  width: 4rpx;
  height: 4rpx;
  background: #171717;
  border-radius: 50%;
}

.management-copy {
  min-width: 0;
}

.management-title {
  overflow: hidden;
  color: #111111;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.management-subtitle {
  overflow: hidden;
  color: #707074;
  font-size: 19rpx;
  font-weight: 400;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chevron--management {
  width: 14rpx;
  height: 14rpx;
}

.opportunity-filters {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  column-gap: 16rpx;
  box-sizing: border-box;
  height: 88rpx;
  margin: 24rpx 28rpx 0;
}

.opportunity-filter {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 44px;
  color: #171717;
  font-size: 24rpx;
  font-weight: 400;
  isolation: isolate;
}

.opportunity-filter::before {
  position: absolute;
  z-index: 0;
  top: 8px;
  right: 0;
  bottom: 8px;
  left: 0;
  border: 1rpx solid #d9d9d9;
  border-radius: 999rpx;
  content: "";
}

.opportunity-filter__label,
.opportunity-apply__label {
  position: relative;
  z-index: 1;
}
.opportunity-filter--active {
  color: #ffffff;
  font-weight: 500;
}

.opportunity-filter--active::before {
  background: #080808;
  border-color: #080808;
}

.opportunity-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  height: 50rpx;
  margin: 24rpx 28rpx 0;
  padding: 0 4rpx;
}


.opportunity-list {
  margin-top: 10rpx;
}

.opportunity-card {
  position: relative;
  box-sizing: border-box;
  width: calc(100% - 56rpx);
  height: 432rpx;
  margin-right: 28rpx;
  margin-left: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #dfdfdf;
  border-radius: 20rpx;
}

.opportunity-card + .opportunity-card {
  margin-top: 16rpx;
}

.opportunity-top {
  position: relative;
  display: grid;
  grid-template-columns: 200rpx minmax(0, 1fr);
  column-gap: 26rpx;
  box-sizing: border-box;
  height: 200rpx;
  padding: 22rpx 22rpx 0;
}

.opportunity-image {
  display: block;
  width: 200rpx;
  height: 176rpx;
  overflow: hidden;
  border-radius: 18rpx;
}

.opportunity-summary {
  min-width: 0;
  padding-top: 8rpx;
  padding-right: 90rpx;
}

.opportunity-title {
  display: -webkit-box;
  overflow: hidden;
  color: #0a0a0a;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 40rpx;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.opportunity-owner,
.opportunity-description {
  overflow: hidden;
  color: #68686d;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.opportunity-owner {
  margin-top: 6rpx;
}

.opportunity-description {
  margin-top: 8rpx;
}

.eligibility-tag {
  position: absolute;
  top: 28rpx;
  right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  padding: 0 15rpx;
  color: #3478f6;
  font-size: 20rpx;
  font-weight: 500;
  background: #edf3ff;
  border-radius: 999rpx;
}

.opportunity-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  box-sizing: border-box;
  height: 86rpx;
  margin: 0 22rpx;
  border-top: 1rpx solid #e2e2e2;
  border-bottom: 1rpx solid #e2e2e2;
}

.opportunity-metric {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.opportunity-metric + .opportunity-metric::before {
  position: absolute;
  top: 19rpx;
  bottom: 19rpx;
  left: 0;
  width: 1rpx;
  background: #e2e2e2;
  content: "";
}

.metric-label {
  color: #6b6b70;
  font-size: 20rpx;
  line-height: 28rpx;
}

.metric-value {
  overflow: hidden;
  max-width: 100%;
  color: #101010;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.opportunity-need {
  display: grid;
  grid-template-columns: 34rpx minmax(0, 1fr);
  column-gap: 14rpx;
  align-items: center;
  box-sizing: border-box;
  height: 62rpx;
  padding: 0 24rpx;
}

.document-glyph {
  position: relative;
  box-sizing: border-box;
  width: 28rpx;
  height: 32rpx;
  border: 3rpx solid #62636a;
  border-radius: 3rpx;
}

.document-glyph__fold {
  position: absolute;
  top: -3rpx;
  right: -3rpx;
  box-sizing: border-box;
  width: 11rpx;
  height: 11rpx;
  background: #ffffff;
  border-bottom: 3rpx solid #62636a;
  border-left: 3rpx solid #62636a;
}

.document-glyph__line {
  position: absolute;
  left: 5rpx;
  height: 2rpx;
  background: #62636a;
  border-radius: 999rpx;
}

.document-glyph__line--one {
  right: 5rpx;
  bottom: 10rpx;
}

.document-glyph__line--two {
  right: 8rpx;
  bottom: 5rpx;
}

.opportunity-need__text {
  overflow: hidden;
  color: #616168;
  font-size: 22rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.opportunity-actions {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  column-gap: 28rpx;
  align-items: center;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 22rpx;
}

.opportunity-detail,
.opportunity-apply {
  display: flex;
  align-items: center;
  height: 44px;
  font-size: 24rpx;
  font-weight: 500;
}

.opportunity-detail {
  justify-content: flex-start;
  color: #111111;
}

.chevron--opportunity {
  width: 15rpx;
  height: 15rpx;
  margin-left: 18rpx;
}

.opportunity-apply {
  position: relative;
  justify-content: center;
  min-width: 0;
  color: #111111;
  isolation: isolate;
}

.opportunity-apply::before {
  position: absolute;
  z-index: 0;
  top: 7px;
  right: 0;
  bottom: 7px;
  left: 0;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  content: "";
}

.opportunity-apply--featured {
  color: #ffffff;
}

.opportunity-apply--featured::before {
  background: #050505;
}

.opportunity-apply--applied {
  color: #77777b;
}

.opportunity-apply--applied::before {
  background: #f2f2f0;
  border-color: #d6d6d6;
}

.opportunity-apply--pressed {
  opacity: 0.7;
}

.opportunity-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 180rpx;
  margin: 10rpx 28rpx 0;
  color: #77777b;
  font-size: 22rpx;
  border: 1rpx solid #e1e1e1;
  border-radius: 20rpx;
}

.application-note {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 74rpx;
  margin: 12rpx 28rpx 14rpx;
  padding: 0 20rpx;
  color: #65666b;
  font-size: 20rpx;
  line-height: 30rpx;
}

.info-glyph {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 26rpx;
  height: 26rpx;
  margin-right: 14rpx;
  font-family: Georgia, serif;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
  border: 2rpx solid #65666b;
  border-radius: 50%;
}
.designer-tab-icon {
  display: block;
  width: 56rpx;
  height: 52rpx;
  opacity: 0.42;
}

.tab-item--active .designer-tab-icon {
  opacity: 1;
}

.designer-projects-preview .tab-label {
  font-size: 22rpx;
  line-height: 30rpx;
}

.tap-soft {
  opacity: 0.58;
}

@media (min-width: 430px) {
  .designer-projects-preview {
    max-width: 430px;
    margin: 0 auto;
    box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.03);
  }
}
