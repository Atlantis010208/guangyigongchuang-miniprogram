/* 会员开通独立页样式（ChatGPT 风格 Tab + 对比表 + CTA）
   配套文档：specs/membership_center/design.md §2.2.3 + §8.5
   全部使用 app.wxss 已有 design tokens，无新增颜色 */

.page {
  background: #f2f2f7;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}

.page-bottom-spacer {
  height: 80rpx;
}

/* ============ 品牌图标占位 ============ */
.brand-icon-wrap {
  display: flex;
  justify-content: center;
  margin-top: 60rpx;
}

.brand-icon-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx dashed #c7c7cc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #c7c7cc;
  letter-spacing: 1rpx;
}

/* ============ 标题区 ============ */
.header {
  padding: 40rpx 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #1d1d1f;
  line-height: 1.2;
  letter-spacing: -1rpx;
  text-align: center;
}

.header-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #8e8e93;
  line-height: 1.5;
  text-align: center;
}

/* ============ Tab 切换器（胶囊容器 + 选中态白凸起） ============ */
.tab-switch {
  margin: 24rpx 30rpx 30rpx;
  background: #e9e9ed;
  border-radius: 999rpx;
  padding: 6rpx;
  display: flex;
  align-items: center;
}

.tab-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #8e8e93;
  transition: all 0.25s ease;
}

.tab-active {
  background: #ffffff;
  color: #1d1d1f;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab-hover {
  opacity: 0.7;
}

/* ============ 权益对比表 ============ */
.benefit-table {
  margin: 0 30rpx 40rpx;
  background: #ffffff;
  border-radius: 30rpx;
  padding: 8rpx 0;
  overflow: hidden;
}

.benefit-row {
  display: flex;
  align-items: center;
  padding: 26rpx 30rpx;
  border-top: 1rpx solid #e5e5ea;
}

.benefit-row:first-child {
  border-top: none;
}

.benefit-header {
  padding-top: 28rpx;
  padding-bottom: 22rpx;
}

.benefit-header .benefit-name {
  font-size: 24rpx;
  color: #8e8e93;
  font-weight: 400;
}

.benefit-header .benefit-col-free,
.benefit-header .benefit-col-current {
  font-size: 24rpx;
  color: #8e8e93;
  font-weight: 400;
}

.benefit-name {
  flex: 1;
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 500;
  line-height: 1.4;
}

.benefit-col-free,
.benefit-col-current {
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.check-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: #c7c7cc;
  line-height: 1;
}

.current-check {
  color: #007aff;
}

.dash-icon {
  font-size: 28rpx;
  color: #c7c7cc;
  line-height: 1;
  font-weight: 400;
}

/* ============ CTA 按钮 ============ */
.cta-wrap {
  padding: 0 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cta-btn {
  width: 100%;
  background: #007aff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 26rpx 0;
  line-height: 1.3;
  border: none;
  box-sizing: border-box;
}

.cta-btn::after {
  border: none;
}

.cta-hover {
  background: #0056cc !important;
  transform: scale(0.98);
  transition: all 0.2s ease;
}

.cta-disabled {
  background: #c7c7cc !important;
  color: #ffffff !important;
}

.renewal-link {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #007aff;
  padding: 8rpx 16rpx;
}

.renewal-link .arrow {
  margin-left: 4rpx;
  color: #007aff;
  font-size: 24rpx;
}

/* ============ 协议说明 ============ */
.agreement-row {
  margin: 36rpx 30rpx 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #8e8e93;
  line-height: 1.5;
}

.agreement-text {
  color: #8e8e93;
}

.agreement-link {
  color: #007aff;
}

.link-hover {
  opacity: 0.6;
}

.arrow {
  color: #c7c7cc;
  font-size: 28rpx;
  margin-left: 6rpx;
}
