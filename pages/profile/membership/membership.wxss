/* 会员中心首页样式
   配套文档：specs/membership_center/design.md §2.2.2
   全部使用 app.wxss 已有 design tokens，无新增颜色 */

.page {
  background: #f2f2f7;
  min-height: 100vh;
  padding-top: 20rpx;
}

.page-bottom-spacer {
  height: 60rpx;
}

/* 通用卡片基类（沿用 profile-card 风格，圆角 40rpx + 白底 + 无阴影） */
.m-card {
  margin: 0 30rpx 30rpx;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
}

.card-hover {
  background: #f8f8f8;
  transition: background 0.2s ease;
}

.btn-hover {
  background: #e5e5ea;
  transition: background 0.2s ease;
}

.btn-hover-primary {
  background: #0056cc !important;
  transform: scale(0.97);
  transition: all 0.2s ease;
}

.link-hover {
  opacity: 0.6;
  transition: opacity 0.2s ease;
}

.arrow {
  color: #c7c7cc;
  font-size: 28rpx;
  margin-left: 8rpx;
}

/* ============ 未登录占位卡片（沿用 home.wxss 的 login-prompt-card） ============ */
.login-prompt-card {
  margin: 30rpx 30rpx 20rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 40rpx 28rpx;
  display: flex;
  align-items: center;
}

.login-prompt-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e5e5ea;
  flex-shrink: 0;
}

.login-prompt-info {
  flex: 1;
  margin-left: 24rpx;
  margin-right: 16rpx;
}

.login-prompt-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 8rpx;
}

.login-prompt-desc {
  display: block;
  font-size: 24rpx;
  color: #86868b;
}

.login-prompt-btn {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  background: #007aff;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  border: none;
  line-height: 1.4;
}

.login-prompt-btn::after {
  border: none;
}

.login-prompt-btn:active {
  background: #0066d6;
}

/* ============ 区块 1：用户状态卡片 ============ */
.status-card {
  padding: 36rpx 28rpx;
}

.status-row {
  display: flex;
  align-items: center;
}

.status-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #e5e5ea;
  flex-shrink: 0;
}

.status-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.status-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.3;
}

.status-label {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #007aff;
  line-height: 1.4;
}

.status-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.4;
}

.status-toolkit-note {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #86868b;
  line-height: 1.4;
}

/* ============ 区块 2：邀请卡片 ============ */
.invite-card {
  padding: 40rpx 32rpx 32rpx;
}

.invite-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  line-height: 1.3;
}

.invite-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.5;
}

.invite-code-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.invite-code-box {
  flex: 1;
  background: rgba(0, 122, 255, 0.08);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.invite-code-label {
  font-size: 22rpx;
  color: #8e8e93;
  line-height: 1.3;
}

.invite-code-value {
  margin-top: 4rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #007aff;
  letter-spacing: 8rpx;
  font-family: 'Menlo', 'Monaco', 'Courier New', monospace;
  line-height: 1.3;
}

.invite-copy-btn {
  background: #f2f2f7;
  color: #007aff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 16rpx 30rpx;
  border: none;
  line-height: 1.3;
}

.invite-copy-btn::after {
  border: none;
}

.invite-progress-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.invite-progress-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(0, 122, 255, 0.12);
  border-radius: 999rpx;
  overflow: hidden;
}

.invite-progress-fill {
  height: 100%;
  background: #007aff;
  border-radius: 999rpx;
  transition: width 0.4s ease-out;
}

.invite-progress-text {
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.3;
  min-width: 90rpx;
  text-align: right;
}

.invite-stats {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.5;
}

.invite-stats:first-of-type {
  margin-top: 16rpx;
}

.invite-share-btn {
  margin-top: 28rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 22rpx 0;
  border: none;
  line-height: 1.3;
}

.invite-share-btn::after {
  border: none;
}

.invite-share-btn[open-type="share"] {
  text-align: center;
}

.invite-link {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #007aff;
}

/* ============ 区块 3：升级入口卡片 / 续费卡片 ============ */
.upgrade-card,
.renewal-card {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx;
}

.upgrade-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.upgrade-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  line-height: 1.3;
}

.upgrade-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.4;
}

.upgrade-arrow {
  font-size: 32rpx;
  color: #c7c7cc;
}

/* ============ 区块 4：购买记录 ============ */
.history-card {
  padding: 32rpx 32rpx 24rpx;
}

.history-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 16rpx;
  line-height: 1.3;
}

.history-list {
  display: flex;
  flex-direction: column;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-top: 1rpx solid #e5e5ea;
}

.history-item:first-child {
  border-top: none;
}

.history-name {
  font-size: 28rpx;
  color: #1d1d1f;
  line-height: 1.4;
}

.history-time {
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.4;
}

.history-more {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 8rpx;
  font-size: 26rpx;
  color: #007aff;
}
