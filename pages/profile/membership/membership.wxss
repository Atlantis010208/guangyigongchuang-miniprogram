/* 会员详情页样式 */
.page {
  background: #F7F8FA;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* --- Top Card --- */
.top-card {
  margin: 30rpx;
  border-radius: 32rpx;
  background: #1A1A1E;
  position: relative;
  overflow: hidden;
  padding: 40rpx;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.1);
}

.tc-bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  border-radius: 32rpx;
  display: block;
}

.tc-bg-fallback {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #2E2F33 0%, #1A1A1E 100%);
  border-radius: 32rpx;
}

.tc-watermark {
  position: absolute;
  right: -20rpx;
  top: -10rpx;
  font-size: 240rpx;
  font-family: 'Georgia', serif;
  font-style: italic;
  color: rgba(255, 255, 255, 0.05);
  line-height: 1;
  pointer-events: none;
}

.tc-content {
  position: relative;
  z-index: 1;
}

.tc-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tc-badge {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #F6D6A8 0%, #D4A66A 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tc-crown {
  width: 32rpx;
  height: 32rpx;
}

.tc-title {
  font-size: 40rpx;
  margin-top: -20rpx; 
  margin-left: 60rpx;
  font-weight: bold;
  color: #FFF;
}

.tc-expire {
  font-size: 26rpx;
  color: #A0A0A5;
  margin-top: 16rpx;
}

.tc-desc {
  font-size: 24rpx;
  color: #8C8C91;
  margin-top: 12rpx;
}

.tc-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.1);
  margin: 30rpx 0;
}

.tc-upgrade-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #D4A66A;
}

.tc-upgrade-arrow {
  font-size: 24rpx;
  color: #D4A66A;
}

.tc-enjoyed-bar {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(212, 166, 106, 0.15);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #D4A66A;
}

.tc-check {
  width: 28rpx;
  height: 28rpx;
}

/* --- Section Shared --- */
.section {
  margin: 0 30rpx 30rpx;
  background: #FFF;
  border-radius: 32rpx;
  padding: 40rpx 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1E;
  margin-bottom: 30rpx;
}

/* --- Grid Benefits --- */
.grid-benefits {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.gb-item {
  background: #F9FAFB;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
}

.gb-item.col-3 {
  width: calc((100% - 40rpx) / 3);
}

.gb-item.col-2 {
  width: calc((100% - 20rpx) / 2);
}

.gb-icon-box {
  width: 80rpx;
  height: 80rpx;
  background: #FFF;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.gb-icon {
  width: 48rpx;
  height: 48rpx;
}

.gb-pro-badge {
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  background: #1A1A1E;
  color: #FFF;
  font-size: 16rpx;
  font-weight: bold;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.gb-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1A1A1E;
  margin-bottom: 8rpx;
}

.gb-sub {
  font-size: 20rpx;
  color: #8C8C91;
  line-height: 1.4;
}

/* --- Compare Table --- */
.compare-table {
  border: 1px solid #F0F0F0;
  border-radius: 16rpx;
  overflow: hidden;
}

.ct-header {
  display: flex;
  background: #FAF9F6;
  padding: 24rpx 0;
  border-bottom: 1px solid #F0F0F0;
  font-size: 24rpx;
  color: #8C8C91;
  align-items: center;
}

.ct-row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1px solid #F0F0F0;
  align-items: center;
}

.ct-row:last-child {
  border-bottom: none;
}

.ct-col {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ct-left {
  flex: 2;
  justify-content: flex-start;
  padding-left: 30rpx;
  font-size: 26rpx;
  color: #1A1A1E;
}

.ct-mid {
  flex: 1;
}

.ct-right {
  flex: 1;
  color: #8C6A3B;
  font-weight: bold;
}

.ct-row-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.ct-crown-small {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.ct-check-icon {
  width: 32rpx;
  height: 32rpx;
}

.ct-note {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #8C8C91;
  margin-top: 24rpx;
}

.ct-note-icon {
  font-size: 24rpx;
}

/* --- Exclusive List --- */
.exclusive-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.ex-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.ex-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: #FDF9F3;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ex-icon {
  width: 40rpx;
  height: 40rpx;
}

.ex-text {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.ex-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1E;
}

.ex-desc {
  font-size: 24rpx;
  color: #8C8C91;
}

/* --- Desc List --- */
.desc-list {
  display: flex;
  flex-direction: column;
}

.dl-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1px solid #F0F0F0;
}

.dl-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dl-item:first-child {
  padding-top: 0;
}

.dl-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.dl-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1E;
  width: 220rpx;
}

.dl-desc {
  flex: 1;
  font-size: 24rpx;
  color: #8C8C91;
}

.dl-arrow {
  font-size: 24rpx;
  color: #C7C7CC;
  margin-left: 20rpx;
}

/* --- Bottom CTA --- */
.bottom-cta {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #F7F8FA;
  padding: 20rpx 30rpx 60rpx;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cta-tip {
  font-size: 22rpx;
  color: #8C8C91;
  margin-bottom: 20rpx;
}

.cta-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #E6C89E 0%, #D4A66A 100%);
  color: #5C3D15;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
}
.cta-btn::after {
  border: none;
}
.cta-btn:active {
  opacity: 0.8;
}
