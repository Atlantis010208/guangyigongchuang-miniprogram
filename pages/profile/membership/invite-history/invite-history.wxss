/* 会员邀请记录页样式
   配套页：pages/profile/membership/invite-history
   全部使用 app.wxss 已有 design tokens，无新增颜色 */

.page {
  background: #f2f2f7;
  min-height: 100vh;
  padding-top: 20rpx;
}

.page-bottom-spacer {
  height: 60rpx;
}

.m-card {
  margin: 0 30rpx 30rpx;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
}

.btn-hover {
  background: #d1d1d6;
  transition: background 0.2s ease;
}

.btn-hover-primary {
  background: #0056cc !important;
  transform: scale(0.97);
  transition: all 0.2s ease;
}

/* ============ 未登录占位 ============ */
.login-prompt-card {
  margin: 30rpx 30rpx 20rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 40rpx 28rpx;
  display: flex;
  align-items: center;
}

.login-prompt-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e5e5ea;
  flex-shrink: 0;
}

.login-prompt-info {
  flex: 1;
  margin-left: 24rpx;
  margin-right: 16rpx;
}

.login-prompt-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 8rpx;
}

.login-prompt-desc {
  display: block;
  font-size: 24rpx;
  color: #86868b;
}

.login-prompt-btn {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  background: #007aff;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  border: none;
  line-height: 1.4;
}

.login-prompt-btn::after {
  border: none;
}

.login-prompt-btn:active {
  background: #0066d6;
}

/* ============ 状态摘要卡 ============ */
.stats-card {
  padding: 36rpx 32rpx 32rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #e5e5ea;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #1d1d1f;
  line-height: 1.1;
  letter-spacing: -1rpx;
}

.stats-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.3;
}

.stats-divider {
  width: 1rpx;
  height: 80rpx;
  background: #e5e5ea;
}

/* 邀请码区块（与 membership 首页统一） */
.invite-code-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.invite-code-box {
  flex: 1;
  background: rgba(0, 122, 255, 0.08);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.invite-code-label {
  font-size: 22rpx;
  color: #8e8e93;
  line-height: 1.3;
}

.invite-code-value {
  margin-top: 4rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #007aff;
  letter-spacing: 8rpx;
  font-family: 'Menlo', 'Monaco', 'Courier New', monospace;
  line-height: 1.3;
}

.invite-copy-btn {
  background: #f2f2f7;
  color: #007aff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 16rpx 30rpx;
  border: none;
  line-height: 1.3;
}

.invite-copy-btn::after {
  border: none;
}

.invite-progress-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.invite-progress-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(0, 122, 255, 0.12);
  border-radius: 999rpx;
  overflow: hidden;
}

.invite-progress-fill {
  height: 100%;
  background: #007aff;
  border-radius: 999rpx;
  transition: width 0.4s ease-out;
}

.invite-progress-text {
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.3;
  min-width: 90rpx;
  text-align: right;
}

.invite-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.5;
}

.invite-share-btn {
  margin-top: 28rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 22rpx 0;
  border: none;
  line-height: 1.3;
  text-align: center;
}

.invite-share-btn::after {
  border: none;
}

/* ============ 规则说明卡 ============ */
.rules-card {
  padding: 32rpx 32rpx 30rpx;
}

.rules-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 16rpx;
  line-height: 1.3;
}

.rules-list {
  display: flex;
  flex-direction: column;
}

.rules-item {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
}

.rules-bullet {
  flex-shrink: 0;
  width: 28rpx;
  font-size: 32rpx;
  color: #007aff;
  line-height: 1.4;
}

.rules-text {
  flex: 1;
  font-size: 26rpx;
  color: #3c3c43;
  line-height: 1.6;
}

/* ============ 邀请记录列表 ============ */
.history-card {
  padding: 32rpx 32rpx 28rpx;
}

.history-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.history-list {
  display: flex;
  flex-direction: column;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 1rpx solid #e5e5ea;
}

.history-item:first-child {
  border-top: none;
}

.history-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.history-name {
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 500;
  line-height: 1.4;
}

.history-time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8e8e93;
  line-height: 1.3;
}

.history-reward {
  flex-shrink: 0;
}

.reward-positive {
  font-size: 26rpx;
  font-weight: 600;
  color: #007aff;
  line-height: 1.3;
}

.reward-pending {
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.3;
}

/* ============ 空状态 ============ */
.empty-state {
  padding: 40rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx dashed #c7c7cc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #c7c7cc;
  letter-spacing: 1rpx;
}

.empty-title {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #1d1d1f;
  line-height: 1.4;
}

.empty-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.5;
  text-align: center;
}
