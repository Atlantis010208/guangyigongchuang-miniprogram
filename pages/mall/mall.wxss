page {
  min-height: 100%;
  color: #161616;
  background: #ffffff;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  color: inherit;
  font: inherit;
  line-height: inherit;
  text-align: left;
  background: transparent;
  border: 0;
  border-radius: 0;
}

button::after {
  border: 0;
}

.mall-page {
  min-height: 100vh;
  overflow-x: hidden;
  background: #ffffff;
}

.navigation {
  background: #f7f7fb;
}

.status-space,
.custom-nav {
  position: relative;
  z-index: 4;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.nav-title {
  color: #151515;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.back-button {
  position: absolute;
  top: 50%;
  left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  transform: translateY(-50%);
}

.back-arrow {
  box-sizing: border-box;
  width: 22rpx;
  height: 22rpx;
  margin-left: 8rpx;
  border-bottom: 4rpx solid #1b1b1b;
  border-left: 4rpx solid #1b1b1b;
  border-radius: 1rpx;
  transform: rotate(45deg);
}

.search-area {
  padding: 18rpx 30rpx 16rpx;
  background: #ffffff;
}

.search-box {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 70rpx;
  padding: 0 22rpx;
  background: #f5f5f8;
  border-radius: 35rpx;
}

.search-icon {
  position: relative;
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 27rpx;
  height: 27rpx;
  margin-right: 18rpx;
  border: 3rpx solid #9aa7b5;
  border-radius: 50%;
}

.search-icon::after {
  position: absolute;
  right: -10rpx;
  bottom: -7rpx;
  width: 13rpx;
  height: 3rpx;
  background: #9aa7b5;
  border-radius: 2rpx;
  content: "";
  transform: rotate(45deg);
  transform-origin: left center;
}

.search-input {
  flex: 1;
  height: 70rpx;
  color: #252525;
  font-size: 27rpx;
  line-height: 70rpx;
}

.search-placeholder {
  color: #abb3bf;
}

.clear-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  color: #a0a0a7;
  font-size: 37rpx;
  font-weight: 300;
}

.tabs-scroll {
  width: 100%;
  height: 82rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #eeeeef;
}

.tabs {
  display: flex;
  height: 82rpx;
  padding: 0 30rpx;
  white-space: nowrap;
}

.tab-item {
  position: relative;
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  height: 82rpx;
  margin-right: 45rpx;
  color: #9a9aa2;
  font-size: 28rpx;
  font-weight: 400;
}

.tab-item--active {
  color: #161616;
  font-weight: 600;
}

.tab-item--active::after {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 5rpx;
  background: #161616;
  border-radius: 4rpx;
  content: "";
}

.product-section {
  box-sizing: border-box;
  padding: 30rpx 30rpx calc(42rpx + env(safe-area-inset-bottom));
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 34rpx 22rpx;
}

.product-card {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.product-image-wrap {
  position: relative;
  width: 100%;
  height: 327rpx;
  overflow: hidden;
  background: #f2f2f3;
  border-radius: 22rpx;
}

.product-image {
  display: block;
  width: 100%;
  height: 100%;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: #f3f3f4;
}

.placeholder-text {
  color: #a5a5aa;
  font-size: 24rpx;
}

.product-info {
  display: flex;
  flex-direction: column;
  padding-top: 14rpx;
}

.product-name {
  display: -webkit-box;
  min-height: 78rpx;
  overflow: hidden;
  color: #171717;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 39rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-desc {
  margin-top: 8rpx;
  overflow: hidden;
  color: #a1a1a8;
  font-size: 24rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price-wrap {
  display: flex;
  align-items: baseline;
  min-height: 44rpx;
  margin-top: 10rpx;
  color: #161616;
}

.price-symbol {
  margin-right: 2rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.price-value {
  font-size: 31rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.price-suffix {
  margin-left: 4rpx;
  color: #a1a1a8;
  font-size: 19rpx;
  font-weight: 400;
}

.loading-state,
.empty-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-height: 430rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 22rpx;
  border: 4rpx solid #ededf0;
  border-top-color: #242424;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.loading-text,
.empty-desc,
.loading-more {
  color: #9a9aa2;
  font-size: 24rpx;
}

.empty-title {
  margin-bottom: 12rpx;
  color: #292929;
  font-size: 30rpx;
  font-weight: 500;
}

.loading-more {
  padding: 36rpx 0 10rpx;
  text-align: center;
}

.tap-pressed {
  opacity: 0.62;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@media (min-width: 430px) {
  .mall-page {
    max-width: 430px;
    margin: 0 auto;
  }
}
