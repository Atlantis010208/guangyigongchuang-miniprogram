/**
 * 答题页样式
 * 视觉 token 复刻自 pages/flows/publish/publish.wxss
 * 关键类：step-container/active、step-header、step-title、option-card、selected、footer-bar、btn-prev、btn-next、slideIn
 */

page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
  height: 100vh;
  overflow: hidden;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
}

/* ========== 顶部进度区 ========== */
.quiz-head {
  padding: 24rpx 48rpx 16rpx;
  background-color: #f5f5f5;
}

.quiz-title {
  font-size: 30rpx;
  color: #888;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.quiz-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.quiz-meta-text {
  font-size: 24rpx;
  color: #a0a5ab;
  font-weight: 400;
}

.progress-bar {
  width: 100%;
  height: 6rpx;
  background-color: #e8e8e8;
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #000;
  border-radius: 3rpx;
  transition: width 0.4s cubic-bezier(0.25, 1, 0.5, 1);
}

/* ========== 主内容区 ========== */
.main-content {
  flex: 1;
  padding: 8rpx 48rpx 240rpx;
  overflow-y: auto;
  position: relative;
}

.main-content::-webkit-scrollbar {
  display: none;
}

.step-container {
  display: none;
  width: 100%;
  animation: slideIn 0.6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

.step-container.active {
  display: block;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-60rpx);
    filter: blur(8rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
    filter: blur(0);
  }
}

/* ========== 题型标签 + 分值 ========== */
.question-tags {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.question-type-tag {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
}

.question-type-tag.type-single {
  color: #1a73e8;
}

.question-type-tag.type-multiple {
  color: #d97706;
}

.question-type-tag.type-judge {
  color: #137333;
}

.question-score {
  font-size: 22rpx;
  color: #a0a5ab;
  font-weight: 500;
  line-height: 1;
}

/* ========== 题干区（复用 publish step-header） ========== */
.step-header {
  margin-bottom: 40rpx;
}

.step-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #000;
  line-height: 1.4;
  letter-spacing: -1rpx;
  margin-bottom: 16rpx;
}

.step-subtitle {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  font-weight: 300;
}

/* ========== 选项列表（复用 publish option-card） ========== */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx 36rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: none;
  position: relative;
  overflow: hidden;
}

.option-card:active {
  transform: scale(0.98);
}

.option-card.selected {
  background-color: #000;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.15);
}

.option-key {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: #f0f2f5;
  color: #555;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: -apple-system, "SF Pro Text", "PingFang SC", monospace;
  transition: all 0.3s ease;
}

.option-card.selected .option-key {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #000;
  line-height: 1.5;
  transition: color 0.3s ease;
  word-break: break-word;
}

.option-card.selected .option-text {
  color: #fff;
}

.option-check {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 底部操作栏（复用 publish footer-bar） ========== */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f5f5f5 70%, rgba(245, 245, 245, 0));
  z-index: 50;
  pointer-events: none;
}

.footer-content {
  display: flex;
  gap: 24rpx;
  pointer-events: auto;
}

.btn-prev {
  width: 200rpx;
  flex-shrink: 0;
  height: 104rpx;
  border-radius: 52rpx;
  background-color: #fff;
  color: #000;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  transition: all 0.3s ease;
}

.btn-prev:active {
  transform: scale(0.98);
  background-color: #f0f0f0;
}

.btn-prev::after {
  border: none;
}

.btn-next {
  flex: 1;
  height: 104rpx;
  border-radius: 52rpx;
  background-color: #000;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.btn-next.disabled {
  background-color: #c4c4c4;
  color: #fff;
  opacity: 1;
  box-shadow: none;
}

.btn-next:not(.disabled):active {
  transform: scale(0.98);
}

.btn-next::after {
  border: none;
}

.submit-error {
  pointer-events: auto;
  margin-top: 16rpx;
  text-align: center;
}

.submit-error-text {
  font-size: 24rpx;
  color: #d93025;
}

/* ========== 加载/错误状态块 ========== */
.state-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 0 48rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(0, 0, 0, 0.08);
  border-top-color: #000;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #fff4e6;
  color: #d97706;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.state-text {
  font-size: 28rpx;
  color: #888;
}

.state-title {
  font-size: 32rpx;
  color: #000;
  font-weight: 500;
}

.state-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  width: 100%;
  max-width: 600rpx;
}

.state-actions .btn-prev,
.state-actions .btn-next {
  flex: 1;
  width: auto;
}
