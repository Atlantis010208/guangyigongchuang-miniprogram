/**
 * 业主端「灯光测试」介绍页样式
 * 视觉 token 复刻自 pages/flows/publish/publish.wxss + pages/quiz/detail/detail.wxss
 * 通用 token 直接复制（小程序 wxss 不支持跨页 @import）
 */

page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
  height: 100vh;
  overflow: hidden;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
}

/* ========== 主内容滚动区 ========== */
.main-content {
  flex: 1;
  height: 100%;
}

/* ========== A. 标题区（hero） ========== */
.hero {
  background-color: #fff;
  padding: 56rpx 48rpx 40rpx;
}

.hero-eyebrow {
  font-size: 24rpx;
  font-weight: 500;
  color: #888;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #000;
  line-height: 1.3;
  letter-spacing: -1rpx;
  margin-bottom: 20rpx;
}

.hero-subtitle {
  font-size: 30rpx;
  font-weight: 300;
  color: #888;
  line-height: 1.6;
}

/* ========== A2. 版本切换 segmented tab ========== */
/* 容器：圆角 pill，浅灰底，两个等宽 tab 内嵌 */
.version-switcher {
  display: flex;
  margin: 16rpx 32rpx 0;
  padding: 6rpx;
  background-color: #ececec;
  border-radius: 999rpx;
  gap: 4rpx;
}

.version-tab {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #888;
  transition: all 0.25s ease;
}

.version-tab:active {
  transform: scale(0.97);
}

/* 选中态：白底 + 弱阴影模拟 iOS segmented control */
.version-tab.active {
  background-color: #fff;
  color: #000;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.version-tab-label {
  font-size: 26rpx;
  line-height: 1;
}

/* 角标：未选中时弱化为浅黑底白字，选中时主色态 */
.version-tab-badge {
  font-size: 18rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background-color: rgba(0, 0, 0, 0.08);
  color: #555;
  letter-spacing: 0.5rpx;
  line-height: 1;
}

.version-tab.active .version-tab-badge {
  background-color: #000;
  color: #fff;
}

/* ========== B. 用途说明卡 ========== */
.purpose-card {
  margin: 24rpx 32rpx 0;
  padding: 32rpx 36rpx;
  background-color: #fff;
  border-radius: 24rpx;
}

.purpose-text {
  font-size: 28rpx;
  font-weight: 400;
  color: #333;
  line-height: 1.7;
}

/* ========== C. 收益栏 ========== */
.benefits-section {
  margin: 32rpx 32rpx 0;
}

.benefits-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.benefit-card {
  position: relative;
  padding: 28rpx 20rpx 32rpx;
  min-height: 180rpx;
  background-color: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
}

.benefit-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #000;
  line-height: 1;
  letter-spacing: -1rpx;
}

.benefit-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.5;
}

/* ========== D. 元信息条 ========== */
.meta-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 40rpx 32rpx 0;
  padding: 20rpx 28rpx;
  font-size: 24rpx;
  color: #a0a5ab;
  font-weight: 400;
}

.meta-item {
  font-size: 24rpx;
  color: #a0a5ab;
}

.meta-divider {
  font-size: 24rpx;
  color: #d8d8d8;
}

/* ========== 底部占位（避开 footer-bar） ========== */
.bottom-spacer {
  height: calc(280rpx + env(safe-area-inset-bottom));
}

/* ========== 底部按钮区（复用 detail.wxss 的 footer-bar / btn-next） ========== */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f5f5f5 70%, rgba(245, 245, 245, 0));
  z-index: 50;
  pointer-events: none;
}

.footer-content {
  display: flex;
  gap: 24rpx;
  pointer-events: auto;
}

.btn-prev {
  width: 200rpx;
  flex-shrink: 0;
  height: 104rpx;
  border-radius: 52rpx;
  background-color: #fff;
  color: #000;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  transition: all 0.3s ease;
}

.btn-prev:active { transform: scale(0.98); background-color: #f0f0f0; }
.btn-prev::after { border: none; }

.btn-next {
  flex: 1;
  height: 104rpx;
  border-radius: 52rpx;
  background-color: #000;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.btn-next.disabled {
  background-color: #c4c4c4;
  color: #fff;
  opacity: 1;
  box-shadow: none;
}

.btn-next:not(.disabled):active { transform: scale(0.98); }
.btn-next::after { border: none; }

/* 「查看上次结果」次链接 */
.last-attempt-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: center;
  pointer-events: auto;
}

.last-attempt-link {
  font-size: 26rpx;
  font-weight: 400;
  color: #888;
  padding: 12rpx 24rpx;
  letter-spacing: 0.5rpx;
}

.last-attempt-link:active {
  color: #000;
}

/* ========== 加载 / 错误状态 ========== */
.state-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 0 48rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(0, 0, 0, 0.08);
  border-top-color: #000;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #fff4e6;
  color: #d97706;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.state-text { font-size: 28rpx; color: #888; }
.state-title { font-size: 32rpx; color: #000; font-weight: 500; }

.state-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  width: 100%;
  max-width: 600rpx;
}

.state-actions .btn-prev {
  flex: 1;
  width: auto;
}
