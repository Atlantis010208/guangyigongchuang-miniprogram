/**
 * 灯光测试历史记录页样式
 * 视觉风格与 lighting-intro / lighting-result 保持一致
 */

page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
  height: 100vh;
  overflow: hidden;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ========== 顶部 Tab ========== */
.tab-bar {
  display: flex;
  background-color: #fff;
  border-bottom: 1rpx solid #ececec;
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  position: relative;
  font-size: 28rpx;
  font-weight: 500;
  color: #888;
}

.tab-item.active {
  color: #000;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: #000;
  border-radius: 2rpx;
}

.tab-label {
  font-size: 28rpx;
  line-height: 1;
}

.tab-count {
  font-size: 20rpx;
  font-weight: 500;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background-color: #000;
  color: #fff;
  line-height: 1.4;
  min-width: 28rpx;
  text-align: center;
}

/* ========== 列表滚动区 ========== */
.list-scroll {
  flex: 1;
  height: 0;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

/* ========== 记录卡片 ========== */
.record-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx 32rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
}

.record-card:active {
  opacity: 0.75;
}

.record-row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-date {
  font-size: 26rpx;
  color: #888;
  font-weight: 400;
}

.record-arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.record-row-bottom {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.level-tag {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.record-score {
  font-size: 28rpx;
  font-weight: 600;
  color: #000;
}

.record-passed {
  font-size: 24rpx;
  font-weight: 500;
}

.record-passed.passed {
  color: #34c759;
}

.record-passed.failed {
  color: #ff3b30;
}

.record-duration {
  font-size: 22rpx;
  color: #bbb;
}

/* ========== 列表底部提示 ========== */
.list-footer {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  padding: 20rpx 0 48rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
  margin-bottom: 16rpx;
  text-align: center;
}

.empty-sub {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.btn-go-test {
  background-color: #000;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 24rpx 80rpx;
  border-radius: 999rpx;
  border: none;
  line-height: 1.4;
}

.btn-go-test:active {
  opacity: 0.8;
}

/* ========== 错误状态 ========== */
.state-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.state-icon {
  width: 80rpx;
  height: 80rpx;
  background-color: #ff3b30;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}

.state-title {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.6);
  text-align: center;
  margin-bottom: 40rpx;
}

.state-actions {
  display: flex;
  gap: 20rpx;
}

.btn-retry {
  background-color: #000;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 64rpx;
  border-radius: 999rpx;
  border: none;
}

/* ========== 骨架屏 ========== */
.skeleton-wrap {
  flex: 1;
}

.skeleton-tab {
  height: 88rpx;
}

.skeleton-list {
  padding: 24rpx 32rpx;
}

.skeleton-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.sk-line {
  height: 28rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.4s infinite;
}

.sk-line-short {
  width: 40%;
}

.sk-line-long {
  width: 70%;
}

.skeleton-block {
  flex: 1;
  height: 48rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.4s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
