<wxs module="cloud" src="./cloud.wxs"></wxs>

<view class="gallery-root">
  <view class="content-wrapper">
    <!-- Header -->
    <view class="header" id="gallery-header">
      <view class="header-content">
        <view class="title">设计灵感库</view>
        <view class="subtitle">高端照明设计灵感</view>
      </view>
    </view>

    <!-- Search Bar -->
    <view class="search-container">
      <view class="search-box">
        <image class="search-icon" src="/images/toolbox/search.svg" mode="aspectFit"></image>
        <input class="search-input" placeholder="搜索灯光场景，多个关键词用空格分隔" placeholder-class="search-placeholder" value="{{searchQuery}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearchConfirm" />
        <view class="search-clear {{searchQuery ? 'visible' : ''}}" catchtap="onClearSearch" hover-class="search-clear-hover">
          <image class="search-clear-icon" src="/images/toolbox/x.svg" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <!-- Sticky Horizontal Tags (Visible when scrolled down) -->
    <!-- 因为配置的是原生导航栏，所以固定在 top: 0 即可。
         stickyCategories 顺序根据当前 activeCategory 动态变化：选中的标签始终置顶在第一位 -->
    <view class="sticky-tags-container {{showStickyTags ? 'visible' : ''}}">
      <scroll-view class="sticky-scroll" scroll-x enable-flex enhanced show-scrollbar="{{false}}" scroll-with-animation>
        <view class="sticky-tag {{activeCategory === item ? 'active' : ''}}" 
              wx:for="{{stickyCategories}}" 
              wx:key="*this"
              bindtap="onCategorySelect" 
              data-category="{{item}}">
          {{item}}
        </view>
      </scroll-view>
    </view>

    <!-- Categories (Dynamic Infinite Cloud Layout via WXS) -->
    <!-- categoryCloud 已经在 JS 层展开为多份副本（by 直接包含 row*torusHeight 偏移），
         WXS 只需按 bx/by 摆放即可，任意 globalY 下视口都持续有标签 -->
    <view class="cloud-wrap" 
          bind:touchstart="{{cloud.touchStart}}" 
          catch:touchmove="{{cloud.touchMove}}" 
          bind:touchend="{{cloud.touchEnd}}"
          bind:touchcancel="{{cloud.touchEnd}}"
          change:activeCategory="{{cloud.onActiveChange}}"
          activeCategory="{{activeCategory}}"
          change:config="{{cloud.onConfigChange}}"
          config="{{categoryCloudConfig}}">
      
      <!-- wxs init 触发器 -->
      <view style="display:none;" 
            change:prop="{{cloud.init}}" prop="{{categoryCloud}}"
            change:config="{{cloud.onConfigChange}}" config="{{categoryCloudConfig}}"
            change:active="{{cloud.onActiveChange}}" active="{{activeCategory}}"></view>

      <view class="cloud-mask-top"></view>
      
      <!-- 视口中心点，所有标签相对于此原点进行 2D 平移 -->
      <view class="cloud-viewport">
        <block wx:for="{{categoryCloud}}" wx:key="key">
          <view class="cloud-tag-wrap" 
                data-bx="{{item.bx}}" 
                data-by="{{item.by}}" 
                data-name="{{item.name}}">
            <view class="cloud-tag {{activeCategory === item.name ? 'active' : ''}}" 
                  bindtap="onCategorySelect" 
                  data-category="{{item.name}}">
              {{item.name}}
            </view>
          </view>
        </block>
      </view>

      <view class="cloud-mask-bottom"></view>
    </view>

    <!-- Gallery Content (Masonry Layout) -->
    <view class="gallery-container">
      <block wx:if="{{isFetching}}">
        <!-- Skeletons -->
        <view class="masonry">
          <view class="masonry-col">
            <view class="skeleton aspect-4-3"></view>
            <view class="skeleton aspect-square"></view>
            <view class="skeleton aspect-3-4"></view>
          </view>
          <view class="masonry-col">
            <view class="skeleton aspect-square"></view>
            <view class="skeleton aspect-3-4"></view>
            <view class="skeleton aspect-4-3"></view>
          </view>
        </view>
      </block>
      <block wx:elif="{{filteredImages.length > 0}}">
        <!-- Waterfall Columns -->
        <view class="masonry">
          <!-- Left Column -->
          <view class="masonry-col">
            <block wx:for="{{leftColImages}}" wx:key="id">
              <view class="image-card hover-scale" bindtap="onImageSelect" data-id="{{item.id}}" id="img-{{item.id}}">
                <view class="image-wrap {{item.aspect}}">
                  <image class="gallery-img {{item.loaded ? 'loaded' : ''}}" src="{{item.thumbUrl}}" mode="aspectFill" bindload="onImageLoad" binderror="onImageError" data-id="{{item.id}}"></image>
                  <view class="favorite-btn" catchtap="onToggleFavorite" data-id="{{item.id}}">
                    <image class="icon-heart" src="/images/toolbox/heart.svg" mode="aspectFit" style="filter: {{favoritesMap[item.id] ? 'invert(29%) sepia(85%) saturate(7386%) hue-rotate(338deg) brightness(108%) contrast(105%)' : 'none'}};"></image>
                  </view>
                </view>
              </view>
            </block>
          </view>
          <!-- Right Column -->
          <view class="masonry-col">
            <block wx:for="{{rightColImages}}" wx:key="id">
              <view class="image-card hover-scale" bindtap="onImageSelect" data-id="{{item.id}}" id="img-{{item.id}}">
                <view class="image-wrap {{item.aspect}}">
                  <image class="gallery-img {{item.loaded ? 'loaded' : ''}}" src="{{item.thumbUrl}}" mode="aspectFill" bindload="onImageLoad" binderror="onImageError" data-id="{{item.id}}"></image>
                  <view class="favorite-btn" catchtap="onToggleFavorite" data-id="{{item.id}}">
                    <image class="icon-heart" src="/images/toolbox/heart.svg" mode="aspectFit" style="filter: {{favoritesMap[item.id] ? 'invert(29%) sepia(85%) saturate(7386%) hue-rotate(338deg) brightness(108%) contrast(105%)' : 'none'}};"></image>
                  </view>
                </view>
              </view>
            </block>
          </view>
        </view>
        
        <!-- Loading More -->
        <view class="loading-more" wx:if="{{hasMore}}">
          <view class="spinner" wx:if="{{isLoadingMore}}"></view>
          <text wx:if="{{isLoadingMore}}">加载更多...</text>
        </view>
      </block>
      <block wx:else>
        <!-- Empty State -->
        <view class="empty-state">
          <view class="empty-icon-wrap">
            <image class="empty-icon" src="{{activeCategory === '收藏' && !searchQuery ? '/images/toolbox/heart.svg' : '/images/toolbox/search.svg'}}" mode="aspectFit"></image>
          </view>
          <view class="empty-title">{{activeCategory === '收藏' && !searchQuery ? '暂无收藏内容' : '未找到相关场景'}}</view>
          <view class="empty-desc">{{activeCategory === '收藏' && !searchQuery ? '点击图片右上角的心形图标即可收藏' : '请尝试更换搜索词或分类'}}</view>
        </view>
      </block>
    </view>
  </view>
</view>

<view wx:if="{{showPaywallModal}}" class="paywall-modal" catchtap="onClosePaywall">
  <view class="paywall-card" catchtap="noop">
    <view class="paywall-card__head">
      <text class="paywall-card__title">高清灵感图库</text>
      <view class="paywall-card__close" bindtap="onClosePaywall">×</view>
    </view>
    <text class="paywall-card__hint">普通用户和普通会员可浏览缩略图，邀请新用户可获得 7 天会员试用</text>

    <view class="paywall-option">
      <text class="paywall-option__title">邀请好友 · 免费试用</text>
      <text class="paywall-option__desc">每邀 2 位新用户注册，得 7 天会员试用</text>
      <view class="paywall-progress">
        <view class="paywall-progress__bar">
          <view class="paywall-progress__fill" style="width: {{paywallInviteProgress.percent}}%;"></view>
        </view>
        <text class="paywall-progress__text">{{paywallInviteProgress.inCycle}} / 2 人</text>
      </view>
      <text class="paywall-option__stats" wx:if="{{paywallInvitedTotal > 0}}">已邀 {{paywallInvitedTotal}} 人 · 累计获 {{paywallTrialGranted}} 天试用</text>
      <button wx:if="{{membership.isLoggedIn}}"
              class="paywall-btn paywall-btn--invite"
              open-type="share"
              hover-class="paywall-btn--hover"
              bindtap="onPaywallInviteTap">邀请好友</button>
      <view wx:else
            class="paywall-btn paywall-btn--invite"
            hover-class="paywall-btn--hover"
            bindtap="onPaywallInviteTap">登录后邀请</view>
    </view>

    <view class="paywall-option">
      <text class="paywall-option__title">升级高级会员 · 解锁图库</text>
      <text class="paywall-option__desc">支持高清大图预览、原图保存，灵感图库不限次使用</text>
      <view class="paywall-btn"
            hover-class="paywall-btn--hover"
            bindtap="onPaywallUpgradeTap">{{membership.isLoggedIn ? '升级高级会员' : '登录后升级'}}</view>
    </view>

    <view class="paywall-card__cancel" bindtap="onClosePaywall">继续浏览缩略图</view>
  </view>
</view>

<!-- Fullscreen Image Modal -->
<view class="modal-overlay {{showModal ? 'visible' : ''}}" 
      style="background-color: rgba(0,0,0,{{1 - dragProgress * 0.85}});"
      bindtap="onCloseModal" catchtouchmove="noop">
  <view class="modal-close" catchtap="onCloseModal" style="opacity: {{1 - dragProgress}};">
    <image class="icon-close" src="/images/toolbox/x.svg" mode="aspectFit"></image>
  </view>

  <swiper wx:if="{{showModal}}" 
          class="modal-swiper {{isDragging ? '' : 'swiper-elastic'}}" 
          style="transform: translateY({{dragY}}px); opacity: {{1 - dragProgress * 0.3}};"
          current="{{currentSwiperIndex}}" bindchange="onSwiperChange" duration="300" circular="{{false}}">
    <block wx:for="{{filteredImages}}" wx:key="id">
      <swiper-item class="modal-swiper-item">
        <view class="modal-image-wrap" 
              catchtap="toggleModalControls"
              bindtouchstart="onPreviewDragStart"
              bindtouchmove="onPreviewDragMove"
              bindtouchend="onPreviewDragEnd"
              bindtouchcancel="onPreviewDragEnd">
          <image class="modal-image" src="{{item.previewUrl || item.thumbUrl}}" mode="aspectFit" lazy-load></image>
        </view>
      </swiper-item>
    </block>
  </swiper>

  <view class="modal-controls {{showControls ? 'visible' : ''}}" style="opacity: {{showControls ? (1 - dragProgress) : 0}};" catchtap="noop">
    <view class="modal-actions">
      <view class="action-btn circle" catchtap="onToggleFavoriteCurrent">
        <image class="icon-heart-large" src="/images/toolbox/heart.svg" mode="aspectFit" style="filter: {{favoritesMap[filteredImages[currentSwiperIndex].id] ? 'invert(29%) sepia(85%) saturate(7386%) hue-rotate(338deg) brightness(108%) contrast(105%)' : 'none'}}"></image>
      </view>
      <view class="action-btn pill" catchtap="onDownloadCurrent">
        <image class="icon-download" src="/images/toolbox/download.svg" mode="aspectFit"></image>
        <text>{{isDownloading ? '下载中...' : '下载图片'}}</text>
      </view>
    </view>
  </view>
</view>

