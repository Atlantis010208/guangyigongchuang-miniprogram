/**
 * 视频播放页样式
 * 使用原生控制条
 */

.container-dark {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #000000;
  overflow: hidden;
}

/* Loading */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #007aff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
}

/* Error */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 40rpx;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  background-color: #FF3B30;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.error-text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 30rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.retry-btn {
  background-color: #007aff;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
  border: none;
}

/* Video Wrapper */
.video-wrapper {
  position: relative;
  width: 100%;
  height: 420rpx;
  background-color: #000000;
  flex-shrink: 0;
  overflow: hidden;
}

.video-player {
  width: 100%;
  height: 100%;
  background-color: #000000;
}

/* 缓冲提示层 */
/* 真机上 video 组件 show-loading="{{false}}" 不一定生效，会出现原生 loading 转圈 */
/* 这里用接近不透明的纯黑遮罩，把 video 的 poster 残影和原生 loading 都盖住 */
/* 只暴露自定义 buffering-spinner 一个加载动效 */
.buffering-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #000000;
  z-index: 10;
  pointer-events: none;
}

.buffering-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #007aff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.buffering-text {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  font-weight: 500;
}

.buffering-hint {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
  text-align: center;
  padding: 0 40rpx;
}

/* 视频占位符 */
.video-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #000000;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.placeholder-text {
  color: rgba(255, 255, 255, 0.5);
  font-size: 28rpx;
  line-height: 1.5;
  text-align: center;
}

.video-retry-btn {
  margin-top: 24rpx;
  width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background-color: #007aff;
  color: #ffffff;
  font-size: 26rpx;
}

.video-retry-btn::after {
  border: 0;
}

/* 固定头部：课程列表标题 + 当前播放 + 视频章节时间轴 */
.playlist-header {
  background-color: #1C1C1E;
  padding: 30rpx 30rpx 0;
  flex-shrink: 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

/* Playlist Section */
.playlist-section {
  flex: 1;
  height: 0; /* 关键：配合 flex:1 让 scroll-view 能正确滚动 */
  background-color: #1C1C1E;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.video-time-chapters {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
}

.chapters-list {
  display: flex;
  flex-direction: column;
  gap: 0; /* 更加紧凑 */
  margin-top: 0;
  padding: 0; /* 移除卡片内边距 */
  background: none; /* 移除卡片背景 */
  backdrop-filter: none; /* 移除毛玻璃 */
  border-radius: 0; /* 移除圆角 */
  transition: none;
  border: none; /* 移除边框 */
}

.video-time-chapter-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  padding: 4rpx 0; /* 更加紧凑的间距 */
  min-height: 32rpx;
}

.chapter-time {
  min-width: 110rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, monospace;
  color: #007aff; 
  font-weight: 500;
  font-size: 24rpx;
}

.chapter-name {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, 0.45);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 26rpx;
  transition: color 0.3s ease;
}

.chapters-expand-btn {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-top: 4rpx;
  padding: 8rpx 0;
  background: none;
  border: none;
}

.expand-text {
  font-size: 24rpx;
  color: #007aff; /* 改为蓝色文字按钮，更有交互感 */
  letter-spacing: 0.5rpx;
  font-weight: 500;
  min-width: 110rpx; /* 确保按钮文字与上方时间宽度一致或对齐 */
}

.expand-icon {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.expand-icon.down {
  border-top: 8rpx solid rgba(255, 255, 255, 0.3);
}

.expand-icon.up {
  border-bottom: 8rpx solid rgba(255, 255, 255, 0.3);
}

.video-time-chapter-item.active .chapter-name {
  color: #ffffff; 
  font-weight: 500;
}

.video-time-chapter-item.active .chapter-time {
  color: #007aff;
  font-weight: 600;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
}

/* 左右布局：当前播放 + 观看人数 */
.section-subtitle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-subtitle {
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 观看人数样式 */
.viewer-info {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.viewer-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.viewer-count {
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
  white-space: nowrap;
}

/* 已学习人数 */
.learned-count {
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
  display: block;
  margin-top: 16rpx;
}

.chapter-group {
  margin-bottom: 30rpx;
}

.chapter-group:last-child {
  margin-bottom: 60rpx; /* 最后一组增加底部间距，确保能滚动到底部 */
}

.chapter-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.chapter-title {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  font-weight: 500;
  padding: 16rpx 0;
  display: block;
  flex: 1;
}

.lesson-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06); /* 恢复底部分割线 */
}

.lesson-item.active {
  background-color: rgba(0, 122, 255, 0.1);
  margin: 0 0rpx;
  padding: 24rpx 20rpx;
  border-radius: 80rpx;
}

.lesson-status {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.status-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
}

.status-icon.playing {
  background-color: #007aff;
  box-shadow: 0 0 10rpx rgba(0, 122, 255, 0.5);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.2); opacity: 0.7; }
}

.lesson-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 20rpx; /* 防止文字太长紧贴按钮 */
}

.lesson-title {
  color: rgba(255, 255, 255, 0.9);
  font-size: 30rpx;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.lesson-title.active-text {
  color: #007aff;
  font-weight: 500;
}

.lesson-duration {
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
}

/* 课程列表元数据容器 */
.lesson-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

/* 课时学习进度状态 */
.lesson-progress {
  font-size: 24rpx;
  margin-left: 8rpx;
  font-weight: 500;
}

.lesson-progress.completed {
  color: #34c759; /* Apple Green - 已完成 */
}

.lesson-progress.learning {
  color: rgba(255, 255, 255, 0.4); /* Apple Orange - 学习中 */
}

.lesson-progress.not-started {
  color: rgba(255, 255, 255, 0.4); /* Gray - 未开始 */
}

/* 🆕 作业课时徽章 */
.lesson-quiz-badge {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  background-color: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  letter-spacing: 0.5rpx;
}

/* 🆕 作业课时通过标识 */
.lesson-quiz-passed {
  font-size: 22rpx;
  color: #34c759;
  font-weight: 500;
  margin-left: 12rpx;
}

/* 课后作业按钮 - 苹果风格 */
.homework-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  background-color: #1C1C1E; /* 深灰/黑色背景，比纯黑更有质感 */
  border: 1rpx solid rgba(255, 255, 255, 0.15); /* 微弱的白色边框 */
  border-radius: 28rpx;
  flex-shrink: 0;
  margin-left: 10rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.homework-btn:active {
  background-color: #2C2C2E; /* 点击时稍微变亮 */
  transform: scale(0.96);
}

.homework-text {
  font-size: 24rpx;
  color: #FFFFFF; /* 白色文字 */
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* ===== 右上角更多按钮（三个点） ===== */
.more-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  z-index: 20;
}

.more-btn .dot {
  width: 8rpx;
  height: 8rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  margin: 0 4rpx;
}

/* ===== 底部播放选项弹窗 ===== */
.options-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 998;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.options-mask.show {
  opacity: 1;
  visibility: visible;
}

.options-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #F5F5F5;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 999;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.options-panel.show {
  transform: translateY(0);
}

.options-header {
  padding: 30rpx 40rpx 20rpx;
  text-align: center;
}

.options-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.options-content {
  padding: 0 30rpx 40rpx;
}

.option-section {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
}

.option-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 24rpx;
}

.speed-options {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.speed-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background-color: transparent;
  transition: all 0.2s;
}

.speed-item text {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

.speed-item.active text {
  color: #007aff;
  font-weight: 600;
}

/* 🆕 清晰度选项样式 */
.quality-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
}

.quality-item {
  flex: 1;
  min-width: 180rpx;
  height: 72rpx; /* 稍微增加高度 */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1c1c1e; /* 黑色文字 */
  transition: all 0.2s;
  font-weight: 500;
}

.quality-item.active {
  background: #FFFFFF; /* 白色背景 */
  color: #007aff;      /* 蓝色文字 */
  font-weight: 600;
  
}

.quality-item:active {
  opacity: 0.7;
  transform: scale(0.98);
}

/* ==========================================================================
   资料下载弹窗（复用课程详情页"课程包下载"样式）
   ========================================================================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal-mask.show {
  opacity: 1;
  visibility: visible;
}

.modal-container {
  width: 620rpx;
  background-color: #ffffff;
  border-radius: 40rpx;
  padding: 48rpx 0 0 0;
  overflow: hidden;
  transition: transform 0.3s cubic-bezier(0.19, 1, 0.22, 1);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 0 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.5rpx;
}

.modal-body {
  min-height: 320rpx;
  transition: all 0.3s;
}

.link-section {
  padding: 24rpx 40rpx 32rpx 40rpx;
}

.modal-body .info-card {
  margin: 0;
  padding: 0;
  box-shadow: none;
  background-color: transparent;
  display: block;
}

.modal-body .info-row {
  margin-bottom: 32rpx;
}

.modal-body .info-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 16rpx;
  display: block;
}

.modal-body .info-value-box {
  background-color: #f5f5f7;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  min-height: auto;
}

.modal-body .info-text {
  font-size: 28rpx;
  color: #1d1d1f;
  line-height: 1.6;
  word-break: break-all;
  flex: 1;
  margin-right: 24rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.modal-body .info-code {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: 4rpx;
  font-family: -apple-system-monospaced, "SF Mono", Menlo, monospace;
}

.modal-body .copy-icon-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.modal-body .icon-copy {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #007aff;
  border-radius: 6rpx;
  position: relative;
  background-color: transparent;
}

.modal-body .icon-copy::after {
  content: '';
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #007aff;
  border-radius: 6rpx;
  background-color: #f5f5f7;
  z-index: 1;
}

.modal-body .btn-group {
  margin-top: 40rpx;
  padding: 0;
}

.black-btn {
  background-color: #1d1d1f;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.black-btn::after {
  border: none;
}

.black-btn:active {
  background-color: #3a3a3c;
  transform: scale(0.98);
}

.full-width {
  width: 100%;
}

.modal-footer {
  border-top: 1rpx solid #e5e5ea;
  padding: 32rpx 0;
  text-align: center;
  background-color: rgba(255, 255, 255, 0.9);
}

.modal-footer text {
  font-size: 32rpx;
  color: #000;
  font-weight: 400;
}
