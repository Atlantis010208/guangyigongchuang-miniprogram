page { background: #f2f2f7; min-height: 100vh; }
.page { min-height: 100vh; padding: 100rpx 36rpx 60rpx; box-sizing: border-box; }
.hero { text-align: center; margin-bottom: 48rpx; }
.success-icon { width: 112rpx; height: 112rpx; line-height: 112rpx; margin: 0 auto 28rpx; border-radius: 50%; background: #111; color: #fff; font-size: 64rpx; font-weight: 600; }
.title { display: block; color: #111; font-size: 44rpx; font-weight: 700; }
.subtitle { display: block; color: #8e8e93; font-size: 26rpx; margin-top: 16rpx; }
.card { background: #fff; border-radius: 28rpx; padding: 34rpx 30rpx; box-shadow: 0 10rpx 30rpx rgba(0,0,0,.04); }
.row { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #f2f2f7; }
.label { color: #8e8e93; font-size: 26rpx; }
.value { color: #111; font-size: 26rpx; max-width: 68%; text-align: right; word-break: break-all; }
.pdf-status { display: flex; align-items: center; gap: 14rpx; margin: 30rpx 0 24rpx; font-size: 28rpx; color: #111; }
.status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #ff9500; }
.ready .status-dot { background: #34c759; }
.failed .status-dot { background: #ff3b30; }
.primary, .secondary { width: 100%; border-radius: 50rpx; font-size: 30rpx; margin: 18rpx 0 0; }
.primary { background: #111; color: #fff; }
.primary[disabled] { background: #c7c7cc; color: #fff; }
.secondary { color: #111; background: #fff; border: 1rpx solid #d1d1d6; }
.actions { display: flex; justify-content: center; gap: 54rpx; margin-top: 48rpx; }
.link-button { padding: 0; margin: 0; background: transparent; color: #666; font-size: 27rpx; }
.link-button::after { border: 0; }
