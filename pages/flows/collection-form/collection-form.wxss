page { height: 100%; background: #FFFFFF; color: #0B0B0B; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.page-shell { height: 100%; background: #FFFFFF; position: relative; overflow: hidden; }
.custom-nav { width: 100%; padding-left: 34rpx; box-sizing: content-box; display: flex; align-items: center; background: #FFFFFF; position: fixed; left: 0; top: 0; z-index: 20; }
.nav-back { width: 70rpx; height: 70rpx; display: flex; align-items: center; }
.back-line { width: 20rpx; height: 20rpx; border-left: 3rpx solid #0B0B0B; border-bottom: 3rpx solid #0B0B0B; transform: rotate(45deg); }
.page-scroll { height: 100%; }
.content { min-height: 100%; padding-left: 40rpx; padding-right: 40rpx; box-sizing: border-box; }
.page-heading { padding-top: 20rpx; display: flex; flex-direction: column; }
.page-title { font-size: 42rpx; line-height: 1.3; font-weight: 650; letter-spacing: -1rpx; }
.page-subtitle { margin-top: 20rpx; color: #777777; font-size: 24rpx; line-height: 1.55; }
.overview-list { margin-top: 48rpx; }
.module-list { display: flex; flex-direction: column; gap: 22rpx; }
.module-card { min-height: 112rpx; padding: 18rpx 24rpx; box-sizing: border-box; border: 2rpx solid #E8E8E8; border-radius: 32rpx; display: flex; align-items: center; }
.module-code, .question-code { width: 56rpx; height: 56rpx; flex-shrink: 0; border: 2rpx solid #0B0B0B; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.module-copy { flex: 1; min-width: 0; padding-left: 22rpx; display: flex; flex-direction: column; gap: 8rpx; }
.module-title { font-size: 28rpx; font-weight: 600; }
.module-meta { font-size: 22rpx; color: #777777; }
.module-status { margin-left: 12rpx; display: flex; align-items: center; gap: 10rpx; font-size: 22rpx; color: #777777; }
.module-status.in_progress { color: #0B0B0B; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #0B0B0B; }
.mini-check { width: 30rpx; height: 30rpx; border-radius: 50%; background: #0B0B0B; color: #FFFFFF; font-size: 20rpx; line-height: 30rpx; text-align: center; }
.module-heading { margin-bottom: 40rpx; }
.question-row { min-height: 90rpx; padding: 12rpx 22rpx; box-sizing: border-box; border: 2rpx solid #E8E8E8; border-radius: 999rpx; display: flex; align-items: center; }
.question-code { width: 54rpx; height: 54rpx; font-size: 23rpx; border-color: #E8E8E8; }
.question-code.is-answered { color: #FFFFFF; background: #0B0B0B; border-color: #0B0B0B; }
.question-name { flex: 1; padding-left: 22rpx; font-size: 27rpx; }
.row-chevron { width: 16rpx; height: 16rpx; border-right: 2rpx solid #0B0B0B; border-top: 2rpx solid #0B0B0B; transform: rotate(45deg); margin-right: 8rpx; }
.question-topline { padding-top: 12rpx; display: flex; align-items: center; justify-content: space-between; }
.module-tag { height: 52rpx; padding: 0 24rpx; border: 2rpx solid #E8E8E8; border-radius: 999rpx; line-height: 52rpx; font-size: 23rpx; }
.question-count { color: #777777; font-size: 25rpx; }
.progress-track { height: 4rpx; margin-top: 24rpx; background: #E8E8E8; overflow: hidden; }
.progress-fill { height: 100%; background: #0B0B0B; }
.question-body { padding-top: 66rpx; }
.question-title { display: block; margin-bottom: 18rpx; font-size: 34rpx; line-height: 1.45; font-weight: 650; }
.question-description { display: block; margin-bottom: 40rpx; color: #777777; font-size: 23rpx; line-height: 1.55; }
.question-description + form-question-renderer { margin-top: 0; }
form-question-renderer { display: block; margin-top: 38rpx; }
.review-heading { margin-bottom: 38rpx; }
.review-list { display: flex; flex-direction: column; gap: 18rpx; }
.review-card { min-height: 106rpx; padding: 18rpx 22rpx; box-sizing: border-box; border: 2rpx solid #E8E8E8; border-radius: 28rpx; display: flex; align-items: center; }
.review-code { width: 52rpx; height: 52rpx; font-size: 24rpx; }
.review-copy { flex: 1; min-width: 0; padding: 0 18rpx; display: flex; flex-direction: column; gap: 8rpx; }
.review-summary { color: #777777; font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.edit-action { padding: 20rpx 8rpx; font-size: 23rpx; }
.completion-pill { height: 94rpx; margin-top: 42rpx; border: 2rpx solid #E8E8E8; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; gap: 20rpx; font-size: 26rpx; }
.completion-check { width: 42rpx; height: 42rpx; border: 2rpx solid #0B0B0B; border-radius: 50%; line-height: 42rpx; text-align: center; font-size: 25rpx; }
.scroll-spacer { height: 190rpx; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; min-height: 144rpx; padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #FFFFFF; z-index: 20; }
.primary-button, .secondary-button { height: 84rpx; margin: 0; padding: 0; border-radius: 999rpx; font-size: 28rpx; font-weight: 500; line-height: 84rpx; }
.primary-button { color: #FFFFFF; background: #0B0B0B; }
.secondary-button { width: 190rpx; color: #0B0B0B; background: #FFFFFF; border: 2rpx solid #E8E8E8; }
.primary-button::after, .secondary-button::after { border: 0; }
.full-button { width: 100%; }
.question-actions { display: flex; gap: 24rpx; }
.next-button { flex: 1; }
