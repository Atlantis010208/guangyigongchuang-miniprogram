page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
  height: 100vh;
  overflow: hidden;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
}

.main-content {
  flex: 1;
  padding: 24rpx 48rpx 200rpx;
  overflow-y: auto;
  position: relative;
}

.main-content::-webkit-scrollbar { display: none; }

.step-container { display: none; width: 100%; animation: slideIn 0.7s cubic-bezier(0.25, 1, 0.5, 1) forwards; }
.step-container.active { display: block; }

@keyframes slideIn {
  from { opacity: 0; transform: translateX(-60rpx); filter: blur(8rpx); }
  to   { opacity: 1; transform: translateX(0);       filter: blur(0);    }
}

.step-header { margin-top: 32rpx; margin-bottom: 48rpx; }

.step-title {
  font-size: 48rpx; font-weight: bold; color: #000;
  line-height: 1.3; letter-spacing: -1rpx; margin-bottom: 20rpx;
}

.step-required { color: #e53935; font-size: 44rpx; font-weight: bold; margin-right: 4rpx; }

.step-subtitle { font-size: 28rpx; color: #888; line-height: 1.6; font-weight: 300; }

.options-list { display: flex; flex-direction: column; gap: 24rpx; }

.option-card {
  background-color: #fff; border-radius: 24rpx; padding: 36rpx 40rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; overflow: hidden;
}
.option-card:active { transform: scale(0.98); }
.option-card.selected { background-color: #000; box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.15); }

.option-text { font-size: 32rpx; font-weight: 500; color: #000; transition: color 0.3s ease; }
.option-card.selected .option-text { color: #fff; }

.option-card.multi { display: flex; align-items: center; gap: 24rpx; padding: 32rpx 40rpx; }

.checkbox-icon {
  flex-shrink: 0; width: 40rpx; height: 40rpx; border-radius: 8rpx;
  border: 2rpx solid #ccc; background-color: #fff;
  transition: all 0.25s ease; position: relative;
}
.checkbox-icon.checked { background-color: #000; border-color: #000; }
.checkbox-icon.checked::after {
  content: ''; position: absolute; left: 8rpx; top: 4rpx;
  width: 16rpx; height: 26rpx; border: 3rpx solid #fff;
  border-top: none; border-left: none; transform: rotate(45deg);
}
.option-card.multi.selected { background-color: #000; }
.option-card.multi.selected .checkbox-icon { background-color: transparent; border-color: rgba(255,255,255,0.6); }
.option-card.multi.selected .checkbox-icon.checked { background-color: transparent; border-color: #fff; }
.option-card.multi.selected .checkbox-icon.checked::after { border-color: #fff; }
.option-card.multi.selected .option-text { color: #fff; }

.other-input-container {
  height: 0; opacity: 0; margin-top: 0; overflow: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); width: 100%;
}
.other-input-container.show { height: 80rpx; opacity: 1; margin-top: 24rpx; }

.other-input {
  width: 100%; height: 100%;
  border-bottom: 1rpx solid rgba(255,255,255,0.3);
  font-size: 30rpx; color: #fff; font-weight: 300;
}
.other-input-placeholder { color: rgba(255,255,255,0.4); }
.option-card:not(.selected) .other-input { border-bottom-color: rgba(0,0,0,0.15); color: #000; }
.option-card:not(.selected) .other-input-placeholder { color: #bbb; }
.option-card.multi .other-input-container { flex: 1; margin-top: 0; }
.option-card.multi.selected .other-input { border-bottom-color: rgba(255,255,255,0.3); color: #fff; }
.option-card.multi:not(.selected) .other-input { border-bottom-color: rgba(0,0,0,0.15); color: #000; }
.option-card.multi:not(.selected) .other-input-placeholder { color: #bbb; }

.textarea-container { background-color: #fff; border-radius: 32rpx; padding: 40rpx 48rpx; box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.04); }
.form-textarea { width: 100%; min-height: 200rpx; font-size: 32rpx; font-weight: 400; color: #000; line-height: 1.7; }
.form-textarea-placeholder { color: #e5e5e5; font-weight: 300; }

.footer-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 40rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f5f5f5 70%, rgba(245,245,245,0));
  z-index: 50; pointer-events: none;
}
.footer-content { display: flex; gap: 24rpx; pointer-events: auto; }

.btn-prev {
  width: 200rpx; flex-shrink: 0; height: 104rpx; border-radius: 52rpx;
  background-color: #fff; color: #000; font-size: 32rpx; font-weight: 500;
  border: none; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease;
}
.btn-prev:active { transform: scale(0.98); background-color: #f0f0f0; }
.btn-prev::after { border: none; }

.btn-next {
  flex: 1; height: 104rpx; border-radius: 52rpx; background-color: #000; color: #fff;
  font-size: 32rpx; font-weight: 500; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.15); transition: all 0.3s ease;
}
.btn-next.disabled { background-color: #c4c4c4; color: #fff; opacity: 1; box-shadow: none; }
.btn-next:not(.disabled):active { transform: scale(0.98); }
.btn-next::after { border: none; }

.thanks-page {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  height: 100vh; padding: 0 80rpx;
  animation: slideIn 0.6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}
.thanks-icon {
  width: 120rpx; height: 120rpx; border-radius: 50%; background-color: #000; color: #fff;
  font-size: 56rpx; line-height: 120rpx; text-align: center; margin-bottom: 48rpx;
}
.thanks-title { font-size: 52rpx; font-weight: bold; color: #000; letter-spacing: -1rpx; margin-bottom: 24rpx; text-align: center; }
.thanks-footer { width: 100%; }
.btn-home {
  width: 100%; height: 104rpx; border-radius: 52rpx; background-color: #000; color: #fff;
  font-size: 32rpx; font-weight: 500; display: flex; align-items: center; justify-content: center;
  border: none; box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.15);
}
.btn-home::after { border: none; }
.btn-home:active { transform: scale(0.98); }

.progress-bar { height: 4rpx; background-color: #ebebeb; position: fixed; top: 0; left: 0; right: 0; z-index: 100; }
.progress-fill { height: 100%; background-color: #000; transition: width 0.4s ease; }
