.page{min-height:100vh;background:#f2f2f7}
.header{padding:30rpx}.title{font-size:44rpx;font-weight:700}

/* 顶部步骤条样式 */
.steps-section {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 30rpx 20rpx;
  /* 增加底部内边距，防止图标被截断 */
  padding: 36rpx 10rpx 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  /* 自定义 Vant Steps 样式变量 */
  --steps-icon-size: 36rpx;
  --steps-title-font-size: 28rpx;
  --steps-description-font-size: 24rpx;
  --steps-line-color: #ebedf0;
  --steps-finish-line-color: #007AFF;
  --steps-finish-text-color: #007AFF;
  --steps-process-text-color: #007AFF;
}

.steps-section .van-steps {
  background: transparent !important;
  /* 确保 Steps 内部有足够的 padding 容纳首尾文字 */
  padding-left: 40rpx !important;
  padding-right: 40rpx !important;
  padding-bottom: 24rpx !important; /* 增加底部 padding */
  overflow: visible !important;
}

/* 强制让内部容器也溢出显示 */
.steps-section .van-step, 
.steps-section .van-step__wrapper {
  overflow: visible !important;
}

/* 步骤圆点样式 */
.steps-section .van-step__circle {
  width: 18rpx !important;
  height: 18rpx !important;
  background-color: #ebedf0 !important;
}

/* 步骤图标样式 */
.steps-section .van-step__icon {
  font-size: 38rpx !important; /* 稍微加大一点字号 */
  /* 确保图标垂直居中且不被截断 */
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 38rpx !important;
  height: auto !important; /* 取消固定高度，避免截断 */
  line-height: 1 !important;
}

/* 步骤标题样式 */
.steps-section .van-step__title {
  font-size: 28rpx !important;
  font-weight: 500;
  /* 增加文字与图标的间距 */
  padding-bottom: 16rpx !important; 
  padding-top: 0 !important;
}

/* 步骤连接线样式 */
.steps-section .van-step__line {
  height: 4rpx !important;
  top: 60rpx !important; /* 微调线条位置以对齐图标 */
  background-color: #ebedf0 !important;
}

/* 步骤标题样式 */
.steps-section .van-step__title {
  font-size: 28rpx !important;
  font-weight: 500;
  /* 增加文字与图标的间距 */
  padding-bottom: 12rpx !important; 
  padding-top: 0 !important;
}

/* 步骤连接线样式 */
.steps-section .van-step__line {
  height: 4rpx !important;
  top: 60rpx !important; /* 微调线条位置以对齐图标 */
  background-color: #ebedf0 !important;
}
.section{background:#fff;border-radius:30rpx;margin:20rpx 30rpx;padding:30rpx}
.info .row{display:block;font-size:28rpx;color:#000;margin-bottom:10rpx}
.block-title{font-size:32rpx;font-weight:700;color:#000;display:block;margin-bottom:12rpx}
.cell{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #f2f2f7}
.cell:last-child{border-bottom:none}
.label{font-size:28rpx;color:#000}
.val{font-size:28rpx;color:#1c1c1e}
.badge.cancel{display:inline-block;margin-top:6rpx;padding:6rpx 14rpx;border-radius:999rpx;background:#ffecec;color:#ff3b30;font-size:22rpx}
.badge.priority{display:inline-block;margin-left:10rpx;margin-top:6rpx;padding:6rpx 14rpx;border-radius:999rpx;background:#000;color:#d4af37;font-size:22rpx;border:1rpx solid #d4af37}
.timeline{margin-top:10rpx}
.t-row{display:flex;align-items:center;gap:14rpx;margin-bottom:14rpx}
.t-dot{width:16rpx;height:16rpx;border-radius:50%;background:#d1d1d6}
.t-dot.done{background:#34c759}
.t-text{font-size:28rpx;color:#000}
.actions{display:flex;align-items:center}
.btn{flex:1;border-radius:50rpx;padding:24rpx 0;font-size:28rpx;border:2rpx solid #000;background:#fff;color:#000}
.actions .btn + .btn{margin-left:16rpx}
.btn.primary{border:2rpx solid #000;background:#fff;color:#000}
.btn.danger{border:2rpx solid #000;background:#fff;color:#000}
.btn.ghost{border:2rpx solid #000;background:#fff;color:#000}
.btn[disabled]{border-color:#d1d1d6;color:#9e9e9e}
/* 更多按钮与图标 */
.btn.more{flex:0 0 65rpx;height:58rpx;padding:0;display:flex;align-items:center;justify-content:center;border-radius:36rpx;border:none;background:transparent}
.more-icon{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;height:30rpx}
.more-icon .dot{width:10rpx;height:10rpx;border-radius:50%;background:#1C1C1E}

/* 文件列表样式 */
.files-section {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f8f8fa;
  border-radius: 16rpx;
}

.file-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e8e8ea;
}

.file-item:last-child {
  border-bottom: none;
}

.file-icon {
  font-size: 32rpx;
}

.file-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.file-name {
  font-size: 26rpx;
  color: #1c1c1e;
  word-break: break-all;
}

.file-size {
  font-size: 22rpx;
  color: #8e8e93;
}

/* 长按复制样式 */
.val.phone,
.val.wechat {
  font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;
  letter-spacing: 0.5rpx;
}

.longpress-copy {
  position: relative;
  padding: 8rpx 16rpx;
  margin: -8rpx -16rpx;
  border-radius: 8rpx;
  transition: background 0.2s;
}

.longpress-copy:active {
  background: #f2f2f7;
}

/* ========== 设计师卡片 ========== */
.designer-section {
  padding: 30rpx;
}

.designer-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0 24rpx;
  border-bottom: 1rpx solid #f2f2f7;
  transition: opacity 0.2s ease;
}

.designer-head:active {
  opacity: 0.6;
}

.designer-head.custom:active {
  opacity: 1;
}

.designer-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f2f2f7;
  flex-shrink: 0;
}

.designer-avatar.custom-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e5e5ea;
}

.custom-avatar-icon {
  font-size: 32rpx;
  color: #8e8e93;
  font-weight: 500;
}

.designer-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.designer-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.designer-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
  line-height: 1.3;
}

.designer-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.3;
}

.designer-tag.accepted {
  background: #e6f7ed;
  color: #34c759;
}

.designer-sub {
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.designer-arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 4rpx 6rpx 12rpx;
}

.designer-arrow-text {
  font-size: 26rpx;
  color: #007AFF;
  font-weight: 500;
}

.designer-arrow-icon {
  font-size: 36rpx;
  color: #007AFF;
  line-height: 1;
  margin-top: -4rpx;
}

/* 联系方式列表 */
.contact-list {
  display: flex;
  flex-direction: column;
}

.contact-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f2f7;
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-label {
  flex-shrink: 0;
  width: 88rpx;
  font-size: 26rpx;
  color: #8e8e93;
}

.contact-val {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1c1c1e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-val.phone,
.contact-val.wechat {
  font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;
  letter-spacing: 0.5rpx;
}

.contact-btn {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: #f2f2f7;
  color: #007AFF;
  transition: all 0.2s ease;
}

.contact-btn:active {
  transform: scale(0.96);
  background: #e5e5ea;
}

.contact-btn.primary {
  background: #007AFF;
  color: #fff;
}

.contact-btn.primary:active {
  background: #0056d3;
}

/* ============================================================
   上传资料 section（业主上传的图片九宫格 + 文件列表）
   设计师端 designer-project-detail.wxss 复制同款样式以保持一致
   ============================================================ */
.attachments-section {
  /* 沿用 .section 的整体卡片留白，无需额外 padding */
}

.block-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
}

.attachments-meta {
  font-size: 24rpx;
  color: #86868B;
  flex-shrink: 0;
}

/* 图片九宫格：3 列等宽，1:1 方形 */
.img-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 24rpx;
}

.img-cell {
  position: relative;
  width: 100%;
  padding-top: 100%; /* 1:1 */
  border-radius: 16rpx;
  overflow: hidden;
  background: #F5F5F7;
}

.img-cell image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.img-cell:active {
  opacity: 0.85;
}

.img-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #86868B;
}

/* 嵌套在 attachments-section 内的 files-section 去掉自身灰底，避免双层卡片 */
.attachments-section .files-section {
  background: transparent;
  padding: 0;
  margin-top: 24rpx;
}

/* 文件项右侧箭头（业主端在新区块内显示交互暗示） */
.file-action {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #C7C7CC;
  margin-left: 12rpx;
}

.attachments-section .file-item:active {
  background: #F5F5F7;
}

/* 小屏降级：iPhone SE / 其他窄屏自动 2 列 */
@media screen and (max-width: 374px) {
  .img-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
