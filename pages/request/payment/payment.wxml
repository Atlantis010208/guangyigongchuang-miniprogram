<view class="payment-page">
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-dot"></view>
    <text>加载付款信息</text>
  </view>

  <block wx:else>
    <view class="page-content">
      <view class="payment-card" wx:if="{{payment}}">
        <text class="amount-label">待支付金额</text>
        <text class="amount">{{amountText}}</text>
        <text class="payment-desc">{{payment.description || '设计服务付款'}}</text>

        <view class="order-row" bindtap="onCopyPaymentNo">
          <text class="order-label">收款单号：</text>
          <text class="order-value">{{payment.paymentRequestNo || paymentRequestNo}}</text>
          <view class="copy-icon" aria-label="复制单号">
            <view class="copy-back"></view>
            <view class="copy-front"></view>
          </view>
        </view>

        <view class="divider"></view>

        <view class="info-row">
          <text class="info-label">服务类型</text>
          <text class="info-value">{{serviceTypeText}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">需求编号</text>
          <text class="info-value">{{payment.requestOrderNo || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">有效期</text>
          <text class="info-value">{{expireText}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">付款状态</text>
          <text class="info-value status-text {{statusClass}}">{{statusText}}</text>
        </view>
      </view>

      <view class="payment-card empty-card" wx:else>
        <text class="empty-title">{{statusText || '付款信息不可用'}}</text>
        <text class="empty-subtitle">请返回聊天或联系管理员重新发送收款链接</text>
      </view>
    </view>

    <view class="bottom-bar">
      <button
        wx:if="{{canPay}}"
        class="wechat-pay-btn"
        loading="{{paying}}"
        disabled="{{paying}}"
        bindtap="onPay"
      >
        <view class="wechat-mark">
          <view class="wechat-dot left"></view>
          <view class="wechat-dot right"></view>
        </view>
        <text>{{paying ? '正在调起支付' : '微信支付'}}</text>
      </button>
      <button wx:else class="wechat-pay-btn disabled" disabled>{{statusText || '暂不可支付'}}</button>

      <view class="safe-tip">
        <view class="shield-icon"></view>
        <text>微信安全支付，保障你的资金安全</text>
      </view>
    </view>
  </block>
</view>
